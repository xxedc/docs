{{ attach_library('dcxe/global') }}

<div class="site">
  <header class="site-header">
    <div class="container container--wide site-header__inner">
      <div class="site-header__left">
        <a class="brand" href="{{ path('<front>') }}">
          <span class="brand__mark">{{ site_name|default('Site') }}</span>
        </a>

        {% if page.primary_menu %}
          <nav class="nav" aria-label="Primary">
            {{ page.primary_menu }}
          </nav>
        {% endif %}
      </div>

      <div class="site-header__center">
        <form class="search" action="{{ path('search.view_node_search') }}" method="get" role="search">
          <label class="visually-hidden" for="q">Search</label>
          <input class="search__input" id="q" name="keys" type="search" placeholder="搜索视频、图片、文章…" />
          <button class="search__btn" type="submit">搜索</button>
        </form>
      </div>

      <div class="site-header__right">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle theme">
          <span class="theme-toggle__icon" aria-hidden="true"></span>
          <span class="theme-toggle__label" data-theme-label>Light</span>
        </button>

        {% if page.header %}
          <div class="user-slot">
            {{ page.header }}
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  <main class="site-main">
    <div class="container container--wide layout">
      <section class="layout__main">
        {{ page.content }}
      </section>

      {% if page.sidebar %}
        <aside class="layout__sidebar">
          <div class="sidebar-card">
            {{ page.sidebar }}
          </div>
        </aside>
      {% endif %}
    </div>
  </main>

  {% if page.footer %}
    <footer class="site-footer">
      <div class="container container--wide">
        {{ page.footer }}
      </div>
    </footer>
  {% endif %}
</div>
