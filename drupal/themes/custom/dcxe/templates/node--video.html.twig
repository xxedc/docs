{% set is_full = view_mode == 'full' %}
{% set video_media = content.field_video|default(content.field_video_url|default(content.field_video_file|default(null))) %}
{% set cover_media = content.field_cover_image|default(content.field_image|default(null)) %}

{% if is_full %}
  <article class="content-detail content-detail--video">
    <header class="content-detail__header">
      <h1 class="content-title">{{ label }}</h1>

      <div class="meta">
        <div class="meta__left">
          {% if author_name is defined %}
            <span class="meta__item">{{ author_name }}</span>
            <span class="meta__dot">·</span>
          {% endif %}
          <time class="meta__item" datetime="{{ node.getCreatedTime|date('c') }}">{{ node.getCreatedTime|date('Y-m-d') }}</time>
        </div>
      </div>
    </header>

    {% if video_media %}
      <div class="media media--video">
        {{ video_media }}
      </div>
    {% endif %}

    <div class="prose">
      {{ content|without('field_video','field_video_url','field_video_file','links') }}
    </div>

    {% if content.links %}
      <div class="content-detail__footer">
        {{ content.links }}
      </div>
    {% endif %}
  </article>
{% else %}
  <article class="card card--video">
    <a class="card__click" href="{{ url }}"></a>

    <div class="media-thumb media-thumb--16x9">
      {% if cover_media %}
        {{ cover_media }}
      {% endif %}
      {% if content.field_duration is defined %}
        <span class="badge badge--duration">{{ content.field_duration }}</span>
      {% endif %}
    </div>

    <div class="card__body">
      <h3 class="card__title">
        <a class="link" href="{{ url }}">{{ label }}</a>
      </h3>
      <div class="meta meta--compact">
        {% if author_name is defined %}
          <span class="meta__item">{{ author_name }}</span>
          <span class="meta__dot">·</span>
        {% endif %}
        <time class="meta__item" datetime="{{ node.getCreatedTime|date('c') }}">{{ node.getCreatedTime|date('Y-m-d') }}</time>
      </div>
    </div>

    <div class="card__actions">
      <button class="icon-btn" type="button" aria-label="Save"></button>
    </div>
  </article>
{% endif %}
