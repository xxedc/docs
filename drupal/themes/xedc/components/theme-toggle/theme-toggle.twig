{#
  theme-toggle.twig — 主题切换器 SDC 组件
  在 page.html.twig 中用：{% include 'xedc:theme-toggle' %}
  交互逻辑由 theme-toggle.js 处理
#}

<button
  class="xedc-theme-toggle"
  data-xedc-theme-toggle
  aria-label="切换主题"
  title="切换主题模式"
>
  {# 太阳图标：深色模式时显示（点击切回浅色）#}
  <svg class="xedc-theme-icon xedc-theme-icon--sun"
       xmlns="http://www.w3.org/2000/svg"
       width="18" height="18" viewBox="0 0 24 24"
       fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
       aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>

  {# 月亮图标：浅色模式时显示（点击切换到深色）#}
  <svg class="xedc-theme-icon xedc-theme-icon--moon"
       xmlns="http://www.w3.org/2000/svg"
       width="18" height="18" viewBox="0 0 24 24"
       fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
       aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>
</button>
