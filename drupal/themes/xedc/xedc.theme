<?php

/**
 * @file
 * xedc.theme — 主题预处理钩子
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;

/**
 * 预处理 html.html.twig
 */
function xedc_preprocess_html(array &$variables): void {
  $variables['#attached']['library'][] = 'xedc/theme-init';
  $variables['#attached']['library'][] = 'xedc/fonts';
  $variables['#attached']['library'][] = 'xedc/global-styles';
  $variables['#attached']['library'][] = 'xedc/global-scripts';
  $variables['#attached']['drupalSettings']['xedc']['defaultTheme'] = 'light';
  $variables['html_attributes']->setAttribute('data-theme', 'light');
}

/**
 * 预处理 page.html.twig
 */
function xedc_preprocess_page(array &$variables): void {
  $config = \Drupal::config('system.site');
  $variables['site_name']   = $config->get('name');
  $variables['site_slogan'] = $config->get('slogan');
  $variables['is_logged_in']  = \Drupal::currentUser()->isAuthenticated();
  $variables['current_user']  = \Drupal::currentUser();

  // 加载当前用户头像 URL（供导航栏使用）
  $current_user = \Drupal::currentUser();
  if ($current_user->isAuthenticated()) {
    $variables['current_user_name'] = $current_user->getDisplayName();
    try {
      $user_entity = \Drupal::entityTypeManager()->getStorage('user')->load($current_user->id());
      if ($user_entity && $user_entity->hasField('user_picture') && !$user_entity->get('user_picture')->isEmpty()) {
        $picture = $user_entity->get('user_picture')->entity;
        if ($picture) {
          $variables['current_user_picture'] = \Drupal::service('file_url_generator')
            ->generateString($picture->getFileUri());
        }
      }
    } catch (\Exception $e) {}
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node) {
    switch ($node->bundle()) {
      case 'video':
        $variables['#attached']['library'][] = 'xedc/page-video-detail';
        break;
      case 'image_post':
        $variables['#attached']['library'][] = 'xedc/page-image-detail';
        break;
      case 'article':
        $variables['#attached']['library'][] = 'xedc/page-article-detail';
        break;
    }
  }

  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['#attached']['library'][] = 'xedc/page-front';
  }
}

/**
 * 预处理 node.html.twig
 */
function xedc_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  $variables['bundle'] = $node->bundle();
  $variables['is_logged_in'] = \Drupal::currentUser()->isAuthenticated();

  if ($node->hasField('field_view_count')) {
    $variables['view_count'] = $node->get('field_view_count')->value ?? 0;
  }
  if ($node->hasField('field_like_count')) {
    $variables['like_count'] = $node->get('field_like_count')->value ?? 0;
  }
  if ($node->hasField('field_cover_image') && !$node->get('field_cover_image')->isEmpty()) {
    $image = $node->get('field_cover_image')->entity;
    if ($image) {
      $variables['cover_image_url'] = $file_url_gen->generateString($image->getFileUri());
    }
  }

  // Preload owner info so Twig templates don't need entity method calls.
  try {
    $owner = $node->getOwner();
    if ($owner) {
      $variables['owner_name']    = $owner->getDisplayName();
      $variables['owner_uid']     = (int) $owner->id();
      $variables['owner_picture_url'] = '';
      if ($owner->hasField('user_picture') && !$owner->get('user_picture')->isEmpty()) {
        $pic = $owner->get('user_picture')->entity;
        if ($pic) {
          $variables['owner_picture_url'] = $file_url_gen->generateString($pic->getFileUri());
        }
      }
    }
  }
  catch (\Exception $e) {
    $variables['owner_name']        = '';
    $variables['owner_uid']         = 0;
    $variables['owner_picture_url'] = '';
  }

  // For image_post: preload all gallery image URLs.
  if ($node->bundle() === 'image_post') {
    $image_urls = [];

    // 1. Try common field names first.
    foreach (['field_images', 'field_image', 'field_gallery', 'field_media_images', 'field_photos', 'field_pictures'] as $fname) {
      if ($node->hasField($fname) && !$node->get($fname)->isEmpty()) {
        foreach ($node->get($fname) as $item) {
          if (!empty($item->entity) && method_exists($item->entity, 'getFileUri')) {
            $uri = $item->entity->getFileUri();
            if ($uri) {
              $image_urls[] = $file_url_gen->generateString($uri);
            }
          }
        }
        if (!empty($image_urls)) {
          break;
        }
      }
    }

    // 2. If still empty, auto-scan ALL image/file fields (skip cover).
    if (empty($image_urls)) {
      try {
        foreach ($node->getFields() as $fname => $field_items) {
          if ($fname === 'field_cover_image' || !str_starts_with($fname, 'field_')) {
            continue;
          }
          if ($field_items->isEmpty()) {
            continue;
          }
          $ftype = $field_items->getFieldDefinition()->getType();
          if (!in_array($ftype, ['image', 'file'], TRUE)) {
            continue;
          }
          foreach ($field_items as $item) {
            $entity = $item->entity ?? NULL;
            if ($entity && method_exists($entity, 'getFileUri')) {
              $uri = $entity->getFileUri();
              if ($uri) {
                $image_urls[] = $file_url_gen->generateString($uri);
              }
            }
          }
          if (!empty($image_urls)) {
            break;
          }
        }
      }
      catch (\Exception $e) {}
    }

    // 3. Last resort: fall back to the cover image.
    if (empty($image_urls) && !empty($variables['cover_image_url'])) {
      $image_urls[] = $variables['cover_image_url'];
    }

    $variables['image_urls'] = $image_urls;
  }
}

/**
 * 预处理 paragraph.html.twig
 */
function xedc_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['bundle'] = $paragraph->bundle();
  if ($paragraph->bundle() === 'code_block') {
    $variables['#attached']['library'][] = 'xedc/prism';
  }
}

/**
 * 预处理 block.html.twig
 */
function xedc_preprocess_block(array &$variables): void {
  if (isset($variables['elements']['#id'])) {
    $variables['block_id'] = $variables['elements']['#id'];
  }
}

/**
 * 预处理 user 实体模板
 */
function xedc_preprocess_user(array &$variables): void {
  $current_user = \Drupal::currentUser();
  $viewed_user  = $variables['user'];

  $variables['is_own_profile']   = ($current_user->id() == $viewed_user->id());
  $variables['current_user_id']  = $current_user->id();
  $variables['is_logged_in']     = $current_user->isAuthenticated();
  $variables['viewed_user_name'] = $viewed_user->getDisplayName();
  $variables['viewed_user_id']   = $viewed_user->id();
  $variables['viewed_user_url']  = $viewed_user->toUrl()->toString();

  // 加载被查看用户的头像 URL
  try {
    if ($viewed_user->hasField('user_picture') && !$viewed_user->get('user_picture')->isEmpty()) {
      $picture = $viewed_user->get('user_picture')->entity;
      if ($picture) {
        $variables['user_picture_url'] = \Drupal::service('file_url_generator')
          ->generateAbsoluteString($picture->getFileUri());
      }
    }
  } catch (\Exception $e) {}

  // 附加个人中心 CSS/JS
  $variables['#attached']['library'][] = 'xedc/page-profile';

  // 查询收藏列表
  $uid_val = (int) $viewed_user->id();
  try {
    $db = \Drupal::database();
    $cnids = $db->select('flagging', 'f')
      ->fields('f', ['entity_id'])
      ->condition('flag_id', 'collect')
      ->condition('uid', $uid_val)
      ->orderBy('created', 'DESC')
      ->range(0, 12)
      ->execute()->fetchCol();
    $variables['collected_items'] = [];
    if (!empty($cnids)) {
      foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($cnids) as $n) {
        $variables['collected_items'][] = ['title' => $n->getTitle(), 'url' => $n->toUrl()->toString(), 'bundle' => $n->bundle()];
      }
    }
  } catch (\Exception $e) { $variables['collected_items'] = []; }

  // 查询历史记录
  try {
    $hnids = $db->select('xedc_history', 'h')
      ->fields('h', ['nid'])
      ->condition('uid', $uid_val)
      ->orderBy('timestamp', 'DESC')
      ->range(0, 12)
      ->execute()->fetchCol();
    $variables['history_items'] = [];
    if (!empty($hnids)) {
      foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($hnids) as $n) {
        $variables['history_items'][] = ['title' => $n->getTitle(), 'url' => $n->toUrl()->toString(), 'bundle' => $n->bundle()];
      }
    }
  } catch (\Exception $e) { $variables['history_items'] = []; }
}

/**
 * 强制 user 实体在 full 视图模式使用 user--full 模板
 */
function xedc_theme_suggestions_user_alter(array &$suggestions, array $variables): void {
  $view_mode = $variables['elements']['#view_mode'] ?? '';
  if ($view_mode === 'full') {
    $suggestions[] = 'user__full';
  }
}

/**
 * 为 Views 列表页附加对应的 CSS/JS 库
 */
function xedc_preprocess_views_view(array &$variables): void {
  $library_map = [
    'image_waterfall' => 'xedc/page-image-list',
    'video_list'      => 'xedc/page-video-list',
    'article_list'    => 'xedc/page-article-list',
  ];
  $view_id = $variables['view']->id();
  if (isset($library_map[$view_id])) {
    $variables['#attached']['library'][] = $library_map[$view_id];
  }
}

/**
 * JSON-LD 结构化数据
 */
function xedc_page_attachments_alter(array &$attachments): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node) return;

  $json_ld = [
    '@context' => 'https://schema.org',
    '@type'    => 'WebPage',
    'name'     => $node->getTitle(),
    'url'      => \Drupal::request()->getUri(),
  ];

  $attachments['#attached']['html_head'][] = [
    [
      '#tag'        => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value'      => json_encode($json_ld, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
    ],
    'json-ld-webpage',
  ];
}

