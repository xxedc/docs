<?php

/**
 * @file
 * xedc.theme — 主题预处理钩子
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * 预处理 html.html.twig
 */
function xedc_preprocess_html(array &$variables): void {
  $variables['#attached']['library'][] = 'xedc/theme-init';
  $variables['#attached']['library'][] = 'xedc/fonts';
  $variables['#attached']['library'][] = 'xedc/global-styles';
  $variables['#attached']['library'][] = 'xedc/global-scripts';
  $variables['#attached']['drupalSettings']['xedc']['defaultTheme'] = 'light';
  $variables['#attached']['drupalSettings']['xedc']['siteName'] = \Drupal::config('system.site')->get('name');
  $variables['html_attributes']->setAttribute('data-theme', 'light');
}

/**
 * 预处理 page.html.twig
 */
function xedc_preprocess_page(array &$variables): void {
  $config = \Drupal::config('system.site');
  $variables['site_name']   = $config->get('name');
  $variables['site_slogan'] = $config->get('slogan');
  $variables['is_logged_in']  = \Drupal::currentUser()->isAuthenticated();
  $variables['current_user']  = \Drupal::currentUser();

  // 加载当前用户头像 URL（供导航栏使用）
  $current_user = \Drupal::currentUser();
  if ($current_user->isAuthenticated()) {
    try {
      $user_entity = \Drupal::entityTypeManager()->getStorage('user')->load($current_user->id());
      $variables['current_user_name'] = $user_entity ? $user_entity->getDisplayName() : $current_user->getAccountName();
      if ($user_entity && $user_entity->hasField('user_picture') && !$user_entity->get('user_picture')->isEmpty()) {
        $picture = $user_entity->get('user_picture')->entity;
        if ($picture) {
          $variables['current_user_picture'] = \Drupal::service('file_url_generator')
            ->generateString($picture->getFileUri());
        }
      }
    } catch (\Exception $e) {}
  }

  // Generate logout URL with CSRF token (bypasses Drupal confirm page).
  if ($current_user->isAuthenticated()) {
    try {
      $logout_url = Url::fromRoute('user.logout', [], [
        'query' => ['token' => \Drupal::service('csrf_token')->get('/user/logout')],
      ])->toString();
      $variables['logout_url'] = $logout_url;
      $variables['#attached']['drupalSettings']['xedc']['logoutUrl'] = $logout_url;
    } catch (\Exception $e) {
      $variables['logout_url'] = '/user/logout';
    }
  } else {
    $variables['logout_url'] = '/user/logout';
  }

  // Load sidebar categories from xie_zhen vocabulary.
  try {
    $cat_tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')
      ->loadTree('xie_zhen', 0, NULL, FALSE);
    $sidebar_cats = [];
    foreach ($cat_tree as $item) {
      $tid = (int) ($item->tid ?? 0);
      if (!$tid) {
        continue;
      }
      $sidebar_cats[] = [
        'tid' => $tid,
        'label' => (string) ($item->name ?? ''),
        'url' => '/images?category=' . $tid,
      ];
    }
    $variables['sidebar_categories'] = $sidebar_cats;
    $variables['#cache']['tags'][] = 'taxonomy_term_list:xie_zhen';
  } catch (\Exception $e) {
    $variables['sidebar_categories'] = [];
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node) {
    switch ($node->bundle()) {
      case 'video':
        $variables['#attached']['library'][] = 'xedc/page-video-detail';
        break;
      case 'image_post':
        $variables['#attached']['library'][] = 'xedc/page-image-detail';
        break;
      case 'article':
        $variables['#attached']['library'][] = 'xedc/page-article-detail';
        break;
    }
  }

  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['#attached']['library'][] = 'xedc/page-front';
    $variables['#attached']['library'][] = 'xedc/page-video-list';
    $variables['#attached']['library'][] = 'xedc/page-image-list';
    $variables['#attached']['library'][] = 'xedc/page-article-list';
  }
}

/**
 * 预处理 node.html.twig
 */
function xedc_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  $variables['bundle'] = $node->bundle();
  $variables['is_logged_in'] = \Drupal::currentUser()->isAuthenticated();

  $format_count = static function (mixed $count): string {
    $count = (int) $count;
    if ($count >= 10_000_000) {
      return round($count / 1_000_000, 1) . 'm';
    }
    if ($count >= 10_000) {
      return round($count / 10_000, 1) . 'w';
    }
    if ($count >= 1_000) {
      return round($count / 1_000, 1) . 'k';
    }
    return (string) $count;
  };

  $format_relative = static function (mixed $timestamp): string {
    $timestamp = (int) $timestamp;
    $now = time();
    $diff = $now - $timestamp;
    if ($diff < 60) {
      return '刚刚';
    }
    if ($diff < 3600) {
      return (int) ($diff / 60) . ' 分钟前';
    }
    if ($diff < 86400) {
      return (int) ($diff / 3600) . ' 小时前';
    }
    if ($diff < 2592000) {
      return (int) ($diff / 86400) . ' 天前';
    }
    if ($diff < 31536000) {
      return (int) ($diff / 2592000) . ' 个月前';
    }
    return (int) ($diff / 31536000) . ' 年前';
  };

  if ($node->hasField('field_view_count')) {
    $variables['view_count'] = $node->get('field_view_count')->value ?? 0;
    $variables['view_count_fmt'] = $format_count($variables['view_count']);
  }
  if ($node->hasField('field_like_count')) {
    $variables['like_count'] = $node->get('field_like_count')->value ?? 0;
    $variables['like_count_fmt'] = $format_count($variables['like_count']);
  }

  $variables['created_relative'] = $format_relative($node->getCreatedTime());

  $variables['tag_names'] = [];
  try {
    if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
      foreach ($node->get('field_tags')->referencedEntities() as $term) {
        $name = (string) $term->label();
        if ($name !== '') {
          $variables['tag_names'][] = $name;
        }
      }
    }
  } catch (\Exception $e) {}

  try {
    $owner = $node->getOwner();
    if ($owner && $owner->hasField('user_picture') && !$owner->get('user_picture')->isEmpty()) {
      $picture = $owner->get('user_picture')->entity;
      if ($picture) {
        $variables['owner_picture_url'] = \Drupal::service('file_url_generator')
          ->generateAbsoluteString($picture->getFileUri());
      }
    }
  } catch (\Exception $e) {}

  if ($node->hasField('field_cover_image') && !$node->get('field_cover_image')->isEmpty()) {
    $image = $node->get('field_cover_image')->entity;
    if ($image) {
      $variables['cover_image_url'] = \Drupal::service('file_url_generator')
        ->generateAbsoluteString($image->getFileUri());
    }
  }
}

/**
 * 预处理 paragraph.html.twig
 */
function xedc_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['bundle'] = $paragraph->bundle();
  if ($paragraph->bundle() === 'code_block') {
    $variables['#attached']['library'][] = 'xedc/prism';
  }
}

/**
 * 预处理 block.html.twig
 */
function xedc_preprocess_block(array &$variables): void {
  if (isset($variables['elements']['#id'])) {
    $variables['block_id'] = $variables['elements']['#id'];
  }
}

/**
 * 预处理 user 实体模板
 */
function xedc_preprocess_user(array &$variables): void {
  $current_user = \Drupal::currentUser();
  $viewed_user  = $variables['user'];
  $uid_val = (int) $viewed_user->id();
  $file_url_generator = \Drupal::service('file_url_generator');

  $variables['is_own_profile']   = ($current_user->id() == $viewed_user->id());
  $variables['current_user_id']  = $current_user->id();
  $variables['is_logged_in']     = $current_user->isAuthenticated();
  $variables['viewed_user_name'] = $viewed_user->getDisplayName();
  $variables['viewed_user_id']   = $viewed_user->id();
  $variables['viewed_user_url']  = $viewed_user->toUrl()->toString();

  try {
    if ($viewed_user->hasField('user_picture') && !$viewed_user->get('user_picture')->isEmpty()) {
      $picture = $viewed_user->get('user_picture')->entity;
      if ($picture) {
        $variables['user_picture_url'] = $file_url_generator->generateAbsoluteString($picture->getFileUri());
      }
    }
  } catch (\Exception $e) {}

  $variables['#attached']['library'][] = 'xedc/page-profile';

  $variables['bio'] = '';
  try {
    $db = \Drupal::database();
    if ($viewed_user->hasField('field_bio') && !$viewed_user->get('field_bio')->isEmpty()) {
      $variables['bio'] = (string) ($viewed_user->get('field_bio')->value ?? '');
    }

    $variables['following_count'] = (int) $db->select('xedc_follows', 'f')
      ->condition('f.follower_id', $uid_val)
      ->countQuery()
      ->execute()
      ->fetchField();
    $variables['followers_count'] = (int) $db->select('xedc_follows', 'f')
      ->condition('f.followee_id', $uid_val)
      ->countQuery()
      ->execute()
      ->fetchField();

    $sum = $db->select('node__field_like_count', 'lc');
    $sum->addExpression('COALESCE(SUM(lc.field_like_count_value), 0)', 'total');
    $sum->join('node_field_data', 'n', 'n.nid = lc.entity_id');
    $sum->condition('n.uid', $uid_val);
    $sum->condition('n.status', 1);
    $sum->condition('n.type', ['article', 'video', 'image_post'], 'IN');
    $variables['like_received_total'] = (int) $sum->execute()->fetchField();
  } catch (\Exception $e) {
    $variables['following_count'] = 0;
    $variables['followers_count'] = 0;
    $variables['like_received_total'] = 0;
  }

  $variables['posts_items'] = [];
  $variables['draft_items'] = [];
  $variables['collected_items'] = [];
  $variables['history_items'] = [];
  $variables['history_groups'] = [];
  $variables['collects_type_counts'] = ['all' => 0, 'video' => 0, 'image_post' => 0, 'article' => 0];

  $build_card = function (NodeInterface $n, ?int $event_ts = NULL, ?string $event_label = NULL) use ($file_url_generator): array {
    $owner = $n->getOwner();
    $owner_name = $owner ? $owner->getDisplayName() : '';
    $owner_url = $owner ? $owner->toUrl()->toString() : '';
    $owner_picture_url = NULL;
    if ($owner && $owner->hasField('user_picture') && !$owner->get('user_picture')->isEmpty()) {
      $picture = $owner->get('user_picture')->entity;
      if ($picture) {
        $owner_picture_url = $file_url_generator->generateAbsoluteString($picture->getFileUri());
      }
    }

    $bundle = $n->bundle();
    $cover_url = NULL;
    $thumbs = [];
    $image_count = 0;
    if ($bundle === 'image_post') {
      if ($n->hasField('field_cover_image') && !$n->get('field_cover_image')->isEmpty()) {
        $f = $n->get('field_cover_image')->entity;
        if ($f) {
          $cover_url = $file_url_generator->generateAbsoluteString($f->getFileUri());
        }
      }
      if (!$cover_url && $n->hasField('field_image') && !$n->get('field_image')->isEmpty()) {
        $f0 = $n->get('field_image')->first()?->entity;
        if ($f0) {
          $cover_url = $file_url_generator->generateAbsoluteString($f0->getFileUri());
        }
      }
      if ($n->hasField('field_image') && !$n->get('field_image')->isEmpty()) {
        $image_count = $n->get('field_image')->count();
        $i = 0;
        foreach ($n->get('field_image') as $item) {
          $f = $item->entity;
          if ($f) {
            $thumbs[] = $file_url_generator->generateAbsoluteString($f->getFileUri());
            $i++;
            if ($i >= 4) {
              break;
            }
          }
        }
      }
    }
    else {
      if ($n->hasField('field_cover_image') && !$n->get('field_cover_image')->isEmpty()) {
        $f = $n->get('field_cover_image')->entity;
        if ($f) {
          $cover_url = $file_url_generator->generateAbsoluteString($f->getFileUri());
        }
      }
    }

    $duration = NULL;
    if ($bundle === 'video' && $n->hasField('field_duration') && !$n->get('field_duration')->isEmpty()) {
      $duration = (int) ($n->get('field_duration')->value ?? 0);
    }

    $excerpt = NULL;
    if ($bundle === 'article' && $n->hasField('field_summary') && !$n->get('field_summary')->isEmpty()) {
      $excerpt = (string) ($n->get('field_summary')->value ?? '');
    }

    $view_count = 0;
    if ($n->hasField('field_view_count') && !$n->get('field_view_count')->isEmpty()) {
      $view_count = (int) ($n->get('field_view_count')->value ?? 0);
    }

    return [
      'nid' => (int) $n->id(),
      'title' => $n->getTitle(),
      'url' => $n->toUrl()->toString(),
      'bundle' => $bundle,
      'created' => (int) $n->getCreatedTime(),
      'event_ts' => $event_ts,
      'event_label' => $event_label,
      'owner_name' => $owner_name,
      'owner_url' => $owner_url,
      'owner_picture_url' => $owner_picture_url,
      'cover_url' => $cover_url,
      'thumbs' => $thumbs,
      'image_count' => $image_count,
      'duration' => $duration,
      'excerpt' => $excerpt,
      'view_count' => $view_count,
    ];
  };

  try {
    $nids = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('uid', $uid_val)
      ->condition('status', 1)
      ->condition('type', ['article', 'video', 'image_post'], 'IN')
      ->sort('created', 'DESC')
      ->range(0, 24)
      ->execute();
    $variables['posts_count'] = (int) \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('uid', $uid_val)
      ->condition('status', 1)
      ->condition('type', ['article', 'video', 'image_post'], 'IN')
      ->count()
      ->execute();
    $nodes = $nids ? \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids) : [];
    foreach ($nids as $nid) {
      $n = $nodes[$nid] ?? NULL;
      if ($n instanceof NodeInterface) {
        $variables['posts_items'][] = $build_card($n, (int) $n->getCreatedTime(), '发布');
      }
    }
  } catch (\Exception $e) {
    $variables['posts_count'] = 0;
  }

  if ($variables['is_own_profile']) {
    try {
      $draft_nids = \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('uid', $uid_val)
        ->condition('status', 0)
        ->condition('type', ['article', 'video', 'image_post'], 'IN')
        ->sort('created', 'DESC')
        ->range(0, 24)
        ->execute();
      $variables['drafts_count'] = (int) \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('uid', $uid_val)
        ->condition('status', 0)
        ->condition('type', ['article', 'video', 'image_post'], 'IN')
        ->count()
        ->execute();
      $draft_nodes = $draft_nids ? \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($draft_nids) : [];
      foreach ($draft_nids as $nid) {
        $n = $draft_nodes[$nid] ?? NULL;
        if ($n instanceof NodeInterface) {
          $variables['draft_items'][] = $build_card($n, (int) $n->getCreatedTime(), '草稿');
        }
      }
    } catch (\Exception $e) {
      $variables['drafts_count'] = 0;
    }
  }
  else {
    $variables['drafts_count'] = 0;
  }

  try {
    $db = \Drupal::database();
    $collect_ts = [];
    $collect_nids = [];

    try {
      $rows = $db->select('xedc_collects', 'c')
        ->fields('c', ['nid', 'timestamp'])
        ->condition('c.uid', $uid_val)
        ->orderBy('c.timestamp', 'DESC')
        ->range(0, 96)
        ->execute()
        ->fetchAll();
      foreach ($rows as $r) {
        $nid = (int) ($r->nid ?? 0);
        $ts = (int) ($r->timestamp ?? 0);
        if ($nid) {
          $collect_ts[$nid] = max($collect_ts[$nid] ?? 0, $ts);
        }
      }
    } catch (\Exception $e) {}

    try {
      $rows = $db->select('flagging', 'f')
        ->fields('f', ['entity_id', 'created'])
        ->condition('f.flag_id', 'collect')
        ->condition('f.uid', $uid_val)
        ->orderBy('f.created', 'DESC')
        ->range(0, 96)
        ->execute()
        ->fetchAll();
      foreach ($rows as $r) {
        $nid = (int) ($r->entity_id ?? 0);
        $ts = (int) ($r->created ?? 0);
        if ($nid) {
          $collect_ts[$nid] = max($collect_ts[$nid] ?? 0, $ts);
        }
      }
    } catch (\Exception $e) {}

    arsort($collect_ts);
    $collect_nids = array_slice(array_keys($collect_ts), 0, 48);
    $variables['collects_count'] = count($collect_ts);
    $collect_nodes = $collect_nids ? \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($collect_nids) : [];
    foreach ($collect_nids as $nid) {
      $n = $collect_nodes[$nid] ?? NULL;
      if ($n instanceof NodeInterface && $n->access('view')) {
        $variables['collected_items'][] = $build_card($n, $collect_ts[$nid] ?? NULL, '收藏');
      }
    }

    $variables['collects_type_counts'] = [
      'all' => count($variables['collected_items']),
      'video' => 0,
      'image_post' => 0,
      'article' => 0,
    ];
    foreach ($variables['collected_items'] as $item) {
      $b = (string) ($item['bundle'] ?? '');
      if (isset($variables['collects_type_counts'][$b])) {
        $variables['collects_type_counts'][$b]++;
      }
    }
  } catch (\Exception $e) {
    $variables['collects_count'] = 0;
  }

  try {
    $db = \Drupal::database();
    $history_rows = $db->select('xedc_history', 'h')
      ->fields('h', ['nid', 'timestamp'])
      ->condition('h.uid', $uid_val)
      ->orderBy('h.timestamp', 'DESC')
      ->range(0, 24)
      ->execute()
      ->fetchAll();

    $history_nids = [];
    $history_ts = [];
    foreach ($history_rows as $r) {
      $nid = (int) ($r->nid ?? 0);
      $ts = (int) ($r->timestamp ?? 0);
      if ($nid) {
        $history_nids[] = $nid;
        $history_ts[$nid] = $ts;
      }
    }
    $variables['history_count'] = (int) $db->select('xedc_history', 'h2')
      ->condition('h2.uid', $uid_val)
      ->countQuery()
      ->execute()
      ->fetchField();
    $history_nodes = $history_nids ? \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($history_nids) : [];
    foreach ($history_nids as $nid) {
      $n = $history_nodes[$nid] ?? NULL;
      if ($n instanceof NodeInterface && $n->access('view')) {
        $variables['history_items'][] = $build_card($n, $history_ts[$nid] ?? NULL, '浏览');
      }
    }

    $groups = [
      'today' => ['label' => '今天', 'items' => []],
      'yesterday' => ['label' => '昨天', 'items' => []],
      'older' => ['label' => '更早', 'items' => []],
    ];
    $tz = new \DateTimeZone(date_default_timezone_get());
    $now = new \DateTimeImmutable('now', $tz);
    $start_today = $now->setTime(0, 0, 0)->getTimestamp();
    $start_yesterday = $now->modify('-1 day')->setTime(0, 0, 0)->getTimestamp();
    foreach ($variables['history_items'] as $item) {
      $ts = (int) ($item['event_ts'] ?? 0);
      if ($ts >= $start_today) {
        $groups['today']['items'][] = $item;
      }
      elseif ($ts >= $start_yesterday) {
        $groups['yesterday']['items'][] = $item;
      }
      else {
        $groups['older']['items'][] = $item;
      }
    }
    $variables['history_groups'] = array_values(array_filter($groups, static fn($g) => !empty($g['items'])));
  } catch (\Exception $e) {
    $variables['history_count'] = 0;
  }
}

/**
 * 强制 user 实体在 full 视图模式使用 user--full 模板
 */
function xedc_theme_suggestions_user_alter(array &$suggestions, array $variables): void {
  $view_mode = $variables['elements']['#view_mode'] ?? '';
  if ($view_mode === 'full') {
    $suggestions[] = 'user__full';
  }
}

/**
 * 为 Views 列表页附加对应的 CSS/JS 库
 */
function xedc_preprocess_views_view(array &$variables): void {
  $library_map = [
    'image_waterfall' => 'xedc/page-image-list',
    'video_list'      => 'xedc/page-video-list',
    'article_list'    => 'xedc/page-article-list',
  ];
  $view_id = $variables['view']->id();
  if (isset($library_map[$view_id])) {
    $variables['#attached']['library'][] = $library_map[$view_id];
  }

  // Cache contexts so query-arg filtering/sorting is respected per unique URL.
  if ($view_id === 'image_waterfall') {
    foreach (['sort', 'tag', 'category', 'search', 'today'] as $arg) {
      $variables['#cache']['contexts'][] = 'url.query_args:' . $arg;
    }
  }
  if ($view_id === 'article_list') {
    foreach (['sort', 'category'] as $arg) {
      $variables['#cache']['contexts'][] = 'url.query_args:' . $arg;
    }
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  if ($view_id === 'article_list') {
    $active_category = (string) ($request?->query->get('category') ?? 'all');
    $active_sort = (string) ($request?->query->get('sort') ?? 'hot');
    if ($active_category === '') {
      $active_category = 'all';
    }
    if (!in_array($active_sort, ['hot', 'new'], TRUE)) {
      $active_sort = 'hot';
    }

    $route_name = 'view.article_list.page_1';
    $base_query = [];
    if ($active_sort !== 'hot') {
      $base_query['sort'] = $active_sort;
    }

    $variables['active_category'] = $active_category;
    $variables['active_sort'] = $active_sort;
    $variables['categories'] = [];
    $variables['sort_hot_url'] = Url::fromRoute($route_name, [], [
      'query' => $active_category !== 'all' ? ['category' => $active_category] : [],
    ])->toString();
    $variables['sort_new_url'] = Url::fromRoute($route_name, [], [
      'query' => array_filter([
        'category' => $active_category !== 'all' ? $active_category : NULL,
        'sort' => 'new',
      ]),
    ])->toString();

    try {
      $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('categories', 0, NULL, FALSE);
      $variables['categories'][] = [
        'key' => 'all',
        'label' => 'All',
        'url' => Url::fromRoute($route_name, [], ['query' => $base_query])->toString(),
      ];
      foreach ($tree as $item) {
        $tid = (int) ($item->tid ?? 0);
        if (!$tid) {
          continue;
        }
        $variables['categories'][] = [
          'key' => (string) $tid,
          'label' => (string) ($item->name ?? ''),
          'url' => Url::fromRoute($route_name, [], [
            'query' => array_merge($base_query, ['category' => $tid]),
          ])->toString(),
        ];
      }
      $variables['#cache']['tags'][] = 'taxonomy_term_list:categories';
    } catch (\Exception $e) {
      $variables['categories'] = [
        [
          'key' => 'all',
          'label' => 'All',
          'url' => Url::fromRoute($route_name)->toString(),
        ],
      ];
    }

    $variables['recommended_authors'] = [];
    $variables['hot_tags'] = [];

    try {
      $nids = \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'article')
        ->condition('status', 1)
        ->sort('created', 'DESC')
        ->range(0, 30)
        ->execute();

      if (!$nids) {
        return;
      }

      $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
      $file_url_generator = \Drupal::service('file_url_generator');

      $authors = [];
      $seen_uids = [];

      foreach ($nodes as $n) {
        $owner = $n->getOwner();
        if (!$owner) {
          continue;
        }
        $uid = (int) $owner->id();
        if (!$uid || isset($seen_uids[$uid])) {
          continue;
        }
        $seen_uids[$uid] = TRUE;

        $picture_url = NULL;
        if ($owner->hasField('user_picture') && !$owner->get('user_picture')->isEmpty()) {
          $picture = $owner->get('user_picture')->entity;
          if ($picture) {
            $picture_url = $file_url_generator->generateAbsoluteString($picture->getFileUri());
          }
        }

        $authors[] = [
          'uid' => $uid,
          'name' => $owner->getDisplayName(),
          'url' => $owner->toUrl()->toString(),
          'picture' => $picture_url,
        ];

        if (count($authors) >= 5) {
          break;
        }
      }

      $tag_counts = [];
      foreach ($nodes as $n) {
        if (!$n->hasField('field_tags') || $n->get('field_tags')->isEmpty()) {
          continue;
        }
        foreach ($n->get('field_tags')->referencedEntities() as $term) {
          $tid = (int) $term->id();
          if (!$tid) {
            continue;
          }
          if (!isset($tag_counts[$tid])) {
            $tag_counts[$tid] = ['term' => $term, 'count' => 0];
          }
          $tag_counts[$tid]['count']++;
        }
      }

      uasort($tag_counts, function ($a, $b) {
        return $b['count'] <=> $a['count'];
      });

      $tags = [];
      foreach ($tag_counts as $item) {
        $term = $item['term'];
        $tags[] = [
          'name' => $term->getName(),
          'url' => $term->toUrl()->toString(),
          'count' => $item['count'],
        ];
        if (count($tags) >= 10) {
          break;
        }
      }

      $variables['recommended_authors'] = $authors;
      $variables['hot_tags'] = $tags;
    } catch (\Exception $e) {}
    return;
  }

  if ($view_id === 'image_waterfall') {
    $active_category = (string) ($request?->query->get('category') ?? 'all');
    if ($active_category === '') {
      $active_category = 'all';
    }

    $active_sort = (string) ($request?->query->get('sort') ?? 'new');
    if (!in_array($active_sort, ['new', 'hot', 'random'], TRUE)) {
      $active_sort = 'new';
    }

    $active_search = (string) ($request?->query->get('search') ?? $request?->query->get('q') ?? '');
    $active_search = trim($active_search);

    $active_today = (string) ($request?->query->get('today') ?? '');
    $active_today = ($active_today === '1' || $active_today === 'true');

    $active_tag = (string) ($request?->query->get('tag') ?? '');
    if ($active_tag !== '' && !ctype_digit($active_tag)) {
      $active_tag = '';
    }

    $route_name = 'view.image_waterfall.page_1';
    $variables['active_category'] = $active_category;
    $variables['active_sort'] = $active_sort;
    $variables['active_search'] = $active_search;
    $variables['active_today'] = $active_today;
    $variables['active_tag'] = $active_tag;
    $variables['categories'] = [];

    $base_query = array_filter([
      'sort' => $active_sort !== 'new' ? $active_sort : NULL,
      'search' => $active_search !== '' ? $active_search : NULL,
      'today' => $active_today ? '1' : NULL,
      'tag' => $active_tag !== '' ? $active_tag : NULL,
    ]);

    $variables['sort_new_url'] = Url::fromRoute($route_name, [], [
      'query' => array_filter([
        'category' => $active_category !== 'all' ? $active_category : NULL,
        'search' => $active_search !== '' ? $active_search : NULL,
        'today' => $active_today ? '1' : NULL,
        'tag' => $active_tag !== '' ? $active_tag : NULL,
      ]),
    ])->toString();

    $variables['sort_hot_url'] = Url::fromRoute($route_name, [], [
      'query' => array_filter([
        'category' => $active_category !== 'all' ? $active_category : NULL,
        'sort' => 'hot',
        'search' => $active_search !== '' ? $active_search : NULL,
        'today' => $active_today ? '1' : NULL,
        'tag' => $active_tag !== '' ? $active_tag : NULL,
      ]),
    ])->toString();

    $variables['sort_random_url'] = Url::fromRoute($route_name, [], [
      'query' => array_filter([
        'category' => $active_category !== 'all' ? $active_category : NULL,
        'sort' => 'random',
        'search' => $active_search !== '' ? $active_search : NULL,
        'today' => $active_today ? '1' : NULL,
        'tag' => $active_tag !== '' ? $active_tag : NULL,
      ]),
    ])->toString();

    $variables['today_url'] = Url::fromRoute($route_name, [], [
      'query' => array_filter([
        'category' => $active_category !== 'all' ? $active_category : NULL,
        'search' => $active_search !== '' ? $active_search : NULL,
        'sort' => $active_sort !== 'new' ? $active_sort : NULL,
        'tag' => $active_tag !== '' ? $active_tag : NULL,
        'today' => '1',
      ]),
    ])->toString();

    $variables['nav_home_url'] = Url::fromRoute($route_name, [], [
      'query' => array_filter([
        'search' => $active_search !== '' ? $active_search : NULL,
      ]),
    ])->toString();
    $variables['nav_new_url'] = $variables['sort_new_url'];
    $variables['nav_hot_url'] = $variables['sort_hot_url'];
    $variables['nav_today_url'] = $variables['today_url'];

    try {
      $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('xie_zhen', 0, NULL, FALSE);
      $variables['categories'][] = [
        'key' => 'all',
        'label' => '全部',
        'url' => Url::fromRoute($route_name, [], ['query' => $base_query])->toString(),
      ];
      foreach ($tree as $item) {
        $tid = (int) ($item->tid ?? 0);
        if (!$tid) {
          continue;
        }
        $variables['categories'][] = [
          'key' => (string) $tid,
          'label' => (string) ($item->name ?? ''),
          'url' => Url::fromRoute($route_name, [], [
            'query' => array_merge($base_query, ['category' => $tid]),
          ])->toString(),
        ];
      }
      $variables['#cache']['tags'][] = 'taxonomy_term_list:xie_zhen';
    } catch (\Exception $e) {
      $variables['categories'] = [
        [
          'key' => 'all',
          'label' => '全部',
          'url' => Url::fromRoute($route_name, [], ['query' => $base_query])->toString(),
        ],
      ];
    }

    $variables['tag_tabs'] = [];
    $variables['tag_terms'] = [];
    try {
      $tag_tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('tags', 0, NULL, FALSE);
      $variables['tag_tabs'] = [
        [
          'key' => 'recommend',
          'label' => '推荐',
          'url' => Url::fromRoute($route_name, [], [
            'query' => array_filter([
              'category' => $active_category !== 'all' ? $active_category : NULL,
              'search' => $active_search !== '' ? $active_search : NULL,
              'today' => $active_today ? '1' : NULL,
            ]),
          ])->toString(),
        ],
        [
          'key' => 'new',
          'label' => '最新',
          'url' => Url::fromRoute($route_name, [], [
            'query' => array_filter([
              'category' => $active_category !== 'all' ? $active_category : NULL,
              'sort' => 'new',
              'search' => $active_search !== '' ? $active_search : NULL,
              'today' => $active_today ? '1' : NULL,
              'tag' => $active_tag !== '' ? $active_tag : NULL,
            ]),
          ])->toString(),
        ],
        [
          'key' => 'hot',
          'label' => '热门',
          'url' => Url::fromRoute($route_name, [], [
            'query' => array_filter([
              'category' => $active_category !== 'all' ? $active_category : NULL,
              'sort' => 'hot',
              'search' => $active_search !== '' ? $active_search : NULL,
              'today' => $active_today ? '1' : NULL,
              'tag' => $active_tag !== '' ? $active_tag : NULL,
            ]),
          ])->toString(),
        ],
      ];

      $used_tag_keys = ['recommend' => TRUE, 'new' => TRUE, 'hot' => TRUE];
      foreach ($tag_tree as $t) {
        $tid = (int) ($t->tid ?? 0);
        $name = (string) ($t->name ?? '');
        if (!$tid || $name === '') {
          continue;
        }
        $key = (string) $tid;
        if (isset($used_tag_keys[$key])) {
          continue;
        }
        $used_tag_keys[$key] = TRUE;
        $variables['tag_tabs'][] = [
          'key' => $key,
          'label' => $name,
          'url' => Url::fromRoute($route_name, [], [
            'query' => array_merge(array_filter([
              'category' => $active_category !== 'all' ? $active_category : NULL,
              'sort' => $active_sort !== 'new' ? $active_sort : NULL,
              'search' => $active_search !== '' ? $active_search : NULL,
              'today' => $active_today ? '1' : NULL,
            ]), ['tag' => $tid]),
          ])->toString(),
        ];
        if (count($variables['tag_tabs']) >= 12) {
          break;
        }
      }

      $variables['#cache']['tags'][] = 'taxonomy_term_list:tags';
    } catch (\Exception $e) {
      $variables['tag_tabs'] = [
        [
          'key' => 'recommend',
          'label' => '推荐',
          'url' => Url::fromRoute($route_name)->toString(),
        ],
      ];
    }

    $variables['stats'] = [
      'total_images' => 0,
      'today_images' => 0,
      'category_count' => 0,
      'total_views' => 0,
      'total_likes' => 0,
    ];

    try {
      $start_today = (new \DateTimeImmutable('today', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();

      $variables['stats']['total_images'] = (int) \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'image_post')
        ->condition('status', 1)
        ->count()
        ->execute();

      $variables['stats']['today_images'] = (int) \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'image_post')
        ->condition('status', 1)
        ->condition('created', $start_today, '>=')
        ->count()
        ->execute();

      $cat_tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('xie_zhen', 0, NULL, FALSE);
      $variables['stats']['category_count'] = is_array($cat_tree) ? count($cat_tree) : 0;

      $db = \Drupal::database();
      $sum_views = $db->select('node__field_view_count', 'vc');
      $sum_views->addExpression('COALESCE(SUM(vc.field_view_count_value), 0)', 'total');
      $sum_views->join('node_field_data', 'n', 'n.nid = vc.entity_id');
      $sum_views->condition('n.type', 'image_post');
      $sum_views->condition('n.status', 1);
      $variables['stats']['total_views'] = (int) $sum_views->execute()->fetchField();

      $sum_likes = $db->select('node__field_like_count', 'lc');
      $sum_likes->addExpression('COALESCE(SUM(lc.field_like_count_value), 0)', 'total');
      $sum_likes->join('node_field_data', 'n2', 'n2.nid = lc.entity_id');
      $sum_likes->condition('n2.type', 'image_post');
      $sum_likes->condition('n2.status', 1);
      $variables['stats']['total_likes'] = (int) $sum_likes->execute()->fetchField();
    } catch (\Exception $e) {}

    $variables['today_updates'] = [];
    try {
      $file_url_generator = \Drupal::service('file_url_generator');
      $start_today = (new \DateTimeImmutable('today', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();
      $nids = \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'image_post')
        ->condition('status', 1)
        ->condition('created', $start_today, '>=')
        ->sort('created', 'DESC')
        ->range(0, 14)
        ->execute();

      if ($nids) {
        $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
        foreach ($nodes as $n) {
          $ts = (int) $n->getCreatedTime();
          $now = time();
          $diff = $now - $ts;
          if ($diff < 60) {
            $created_relative = '刚刚';
          } elseif ($diff < 3600) {
            $created_relative = (int) ($diff / 60) . ' 分钟前';
          } elseif ($diff < 86400) {
            $created_relative = (int) ($diff / 3600) . ' 小时前';
          } elseif ($diff < 2592000) {
            $created_relative = (int) ($diff / 86400) . ' 天前';
          } elseif ($diff < 31536000) {
            $created_relative = (int) ($diff / 2592000) . ' 个月前';
          } else {
            $created_relative = (int) ($diff / 31536000) . ' 年前';
          }

          $cover_url = NULL;
          if ($n->hasField('field_cover_image') && !$n->get('field_cover_image')->isEmpty()) {
            $f = $n->get('field_cover_image')->entity;
            if ($f) {
              $cover_url = $file_url_generator->generateAbsoluteString($f->getFileUri());
            }
          }
          if (!$cover_url && $n->hasField('field_image') && !$n->get('field_image')->isEmpty()) {
            $f0 = $n->get('field_image')->first()?->entity;
            if ($f0) {
              $cover_url = $file_url_generator->generateAbsoluteString($f0->getFileUri());
            }
          }

          $variables['today_updates'][] = [
            'nid' => (int) $n->id(),
            'title' => (string) $n->label(),
            'url' => $n->toUrl()->toString(),
            'cover' => $cover_url,
            'created' => $ts,
            'created_relative' => $created_relative,
          ];
        }
      }
    } catch (\Exception $e) {}
  }
}

/**
 * Replace the view's cache plugin with 'none' at runtime. We need this because:
 *   - hook_views_pre_view / hook_views_pre_execute are MODULE-only hooks and
 *     are NOT invoked for theme implementations in Drupal 10.
 *   - hook_views_query_alter IS invoked for themes (it goes through alter()),
 *     so we piggyback on it.
 *   - The Views cache plugin caches results by view-id + display-id + args,
 *     NOT by URL query args, so our sort/tag/category params are ignored on
 *     a cache hit (the SQL we built here never executes).
 *
 * By reaching into $display_handler->plugins (protected) via reflection and
 * swapping the cache plugin for a 'none' instance, we force a fresh query.
 */
function _xedc_disable_view_cache(\Drupal\views\ViewExecutable $view): void {
  try {
    // Update the option so any later getPlugin('cache') gets the 'none' type.
    $view->display_handler->setOption('cache', ['type' => 'none']);

    // Replace the already-instantiated plugin instance, if any.
    $reflection = new \ReflectionObject($view->display_handler);
    if (!$reflection->hasProperty('plugins')) {
      return;
    }
    $plugins_prop = $reflection->getProperty('plugins');
    $plugins_prop->setAccessible(TRUE);
    $plugins = $plugins_prop->getValue($view->display_handler);

    $none = \Drupal\views\Views::pluginManager('cache')->createInstance('none');
    if ($none) {
      $none->init($view, $view->display_handler);
      $plugins['cache'] = $none;
      $plugins_prop->setValue($view->display_handler, $plugins);
    }
  } catch (\Throwable $e) {
    // Best-effort; if reflection fails, query still runs but may hit cache.
  }
}

function xedc_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() !== 'article_list') {
    if ($view->id() !== 'image_waterfall') {
      return;
    }
  }
  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  $has_filters = $request && (
    (string) ($request->query->get('sort') ?? '') !== ''
    || (string) ($request->query->get('tag') ?? '') !== ''
    || (string) ($request->query->get('category') ?? '') !== ''
    || (string) ($request->query->get('search') ?? '') !== ''
    || (string) ($request->query->get('q') ?? '') !== ''
    || (string) ($request->query->get('today') ?? '') !== ''
  );
  if ($has_filters) {
    _xedc_disable_view_cache($view);
  }

  if ($view->id() === 'article_list') {
    $category = $request?->query->get('category');
    if ($category && $category !== 'all' && ctype_digit((string) $category)) {
      $category_table = $query->ensureTable('node__field_category', $view->relationship);
      if ($category_table) {
        $query->addWhere(0, $category_table . '.field_category_target_id', (int) $category, '=');
      }
    }

    $sort = (string) ($request?->query->get('sort') ?? '');
    if ($sort !== 'new') {
      $view_count_table = $query->ensureTable('node__field_view_count', $view->relationship);
      if ($view_count_table) {
        $query->addOrderBy($view_count_table, 'field_view_count_value', 'DESC');
      }
    }
    return;
  }

  $category = $request?->query->get('category');
  if ($category && $category !== 'all' && ctype_digit((string) $category)) {
    $category_table = $query->ensureTable('node__field_category', $view->relationship);
    if ($category_table) {
      $query->addWhere(0, $category_table . '.field_category_target_id', (int) $category, '=');
    }
  }

  $search = (string) ($request?->query->get('search') ?? $request?->query->get('q') ?? '');
  $search = trim($search);
  if ($search !== '') {
    $base_table = $query->ensureTable('node_field_data', $view->relationship);
    if ($base_table) {
      $escaped = \Drupal::database()->escapeLike($search);
      $query->addWhere(0, $base_table . '.title', '%' . $escaped . '%', 'LIKE');
    }
  }

  $tag = (string) ($request?->query->get('tag') ?? '');
  if ($tag !== '' && ctype_digit($tag)) {
    $tag_table = $query->ensureTable('node__field_tags', $view->relationship);
    if ($tag_table) {
      $query->addWhere(0, $tag_table . '.field_tags_target_id', (int) $tag, '=');
    }
  }

  $today = (string) ($request?->query->get('today') ?? '');
  if ($today === '1' || $today === 'true') {
    $start_today = (new \DateTimeImmutable('today', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();
    $base_table_today = $query->ensureTable('node_field_data', $view->relationship);
    if ($base_table_today) {
      $query->addWhere(0, $base_table_today . '.created', $start_today, '>=');
    }
  }

  $sort = (string) ($request?->query->get('sort') ?? 'new');
  if (!in_array($sort, ['new', 'hot', 'random'], TRUE)) {
    $sort = 'new';
  }

  try {
    $query->orderby = [];
  } catch (\Throwable $e) {}

  $base_table = $query->ensureTable('node_field_data', $view->relationship);

  if ($sort === 'random') {
    $query->addOrderBy(NULL, 'RAND()', 'ASC');
    return;
  }

  if ($sort === 'hot') {
    $view_count_table = $query->ensureTable('node__field_view_count', $view->relationship);
    if ($view_count_table) {
      $query->addOrderBy($view_count_table, 'field_view_count_value', 'DESC');
    }
  }

  if ($base_table) {
    $query->addOrderBy($base_table, 'created', 'DESC');
  }
}

/**
 * 预处理 taxonomy_term（标签/分类页）
 */
function xedc_preprocess_taxonomy_term(array &$variables): void {
  $variables['#attached']['library'][] = 'xedc/page-taxonomy';

  $term = $variables['term'];
  $variables['name'] = $term->label();
  $variables['description'] = '';
  if ($term->hasField('description') && !$term->get('description')->isEmpty()) {
    $variables['description'] = (string) ($term->get('description')->value ?? '');
  }
}

/**
 * JSON-LD 结构化数据
 */
function xedc_page_attachments_alter(array &$attachments): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node) return;

  $json_ld = [
    '@context' => 'https://schema.org',
    '@type'    => 'WebPage',
    'name'     => $node->getTitle(),
    'url'      => \Drupal::request()->getUri(),
  ];

  $attachments['#attached']['html_head'][] = [
    [
      '#tag'        => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value'      => json_encode($json_ld, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
    ],
    'json-ld-webpage',
  ];
}
