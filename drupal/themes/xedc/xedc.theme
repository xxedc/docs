<?php

/**
 * @file
 * xedc.theme — 主题预处理钩子
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * 预处理 html.html.twig
 */
function xedc_preprocess_html(array &$variables): void {
  $variables['#attached']['library'][] = 'xedc/theme-init';
  $variables['#attached']['library'][] = 'xedc/fonts';
  $variables['#attached']['library'][] = 'xedc/global-styles';
  $variables['#attached']['library'][] = 'xedc/global-scripts';
  $variables['#attached']['drupalSettings']['xedc']['defaultTheme'] = 'light';
  $variables['html_attributes']->setAttribute('data-theme', 'light');
}

/**
 * 预处理 page.html.twig
 */
function xedc_preprocess_page(array &$variables): void {
  $config = \Drupal::config('system.site');
  $variables['site_name']   = $config->get('name');
  $variables['site_slogan'] = $config->get('slogan');
  $variables['is_logged_in']  = \Drupal::currentUser()->isAuthenticated();
  $variables['current_user']  = \Drupal::currentUser();

  // 加载当前用户头像 URL（供导航栏使用）
  $current_user = \Drupal::currentUser();
  if ($current_user->isAuthenticated()) {
    $variables['current_user_name'] = $current_user->getDisplayName();
    try {
      $user_entity = \Drupal::entityTypeManager()->getStorage('user')->load($current_user->id());
      if ($user_entity && $user_entity->hasField('user_picture') && !$user_entity->get('user_picture')->isEmpty()) {
        $picture = $user_entity->get('user_picture')->entity;
        if ($picture) {
          $variables['current_user_picture'] = \Drupal::service('file_url_generator')
            ->generateString($picture->getFileUri());
        }
      }
    } catch (\Exception $e) {}
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node) {
    switch ($node->bundle()) {
      case 'video':
        $variables['#attached']['library'][] = 'xedc/page-video-detail';
        break;
      case 'image_post':
        $variables['#attached']['library'][] = 'xedc/page-image-detail';
        break;
      case 'article':
        $variables['#attached']['library'][] = 'xedc/page-article-detail';
        break;
    }
  }

  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['#attached']['library'][] = 'xedc/page-front';
    $variables['#attached']['library'][] = 'xedc/page-video-list';
    $variables['#attached']['library'][] = 'xedc/page-image-list';
    $variables['#attached']['library'][] = 'xedc/page-article-list';
  }
}

/**
 * 预处理 node.html.twig
 */
function xedc_preprocess_node(array &$variables): void {
  $node = $variables['node'];
  $variables['bundle'] = $node->bundle();
  $variables['is_logged_in'] = \Drupal::currentUser()->isAuthenticated();

  if ($node->hasField('field_view_count')) {
    $variables['view_count'] = $node->get('field_view_count')->value ?? 0;
  }
  if ($node->hasField('field_like_count')) {
    $variables['like_count'] = $node->get('field_like_count')->value ?? 0;
  }

  try {
    $owner = $node->getOwner();
    if ($owner && $owner->hasField('user_picture') && !$owner->get('user_picture')->isEmpty()) {
      $picture = $owner->get('user_picture')->entity;
      if ($picture) {
        $variables['owner_picture_url'] = \Drupal::service('file_url_generator')
          ->generateAbsoluteString($picture->getFileUri());
      }
    }
  } catch (\Exception $e) {}

  if ($node->hasField('field_cover_image') && !$node->get('field_cover_image')->isEmpty()) {
    $image = $node->get('field_cover_image')->entity;
    if ($image) {
      $variables['cover_image_url'] = \Drupal::service('file_url_generator')
        ->generateAbsoluteString($image->getFileUri());
    }
  }
}

/**
 * 预处理 paragraph.html.twig
 */
function xedc_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];
  $variables['bundle'] = $paragraph->bundle();
  if ($paragraph->bundle() === 'code_block') {
    $variables['#attached']['library'][] = 'xedc/prism';
  }
}

/**
 * 预处理 block.html.twig
 */
function xedc_preprocess_block(array &$variables): void {
  if (isset($variables['elements']['#id'])) {
    $variables['block_id'] = $variables['elements']['#id'];
  }
}

/**
 * 预处理 user 实体模板
 */
function xedc_preprocess_user(array &$variables): void {
  $current_user = \Drupal::currentUser();
  $viewed_user  = $variables['user'];

  $variables['is_own_profile']   = ($current_user->id() == $viewed_user->id());
  $variables['current_user_id']  = $current_user->id();
  $variables['is_logged_in']     = $current_user->isAuthenticated();
  $variables['viewed_user_name'] = $viewed_user->getDisplayName();
  $variables['viewed_user_id']   = $viewed_user->id();
  $variables['viewed_user_url']  = $viewed_user->toUrl()->toString();

  // 加载被查看用户的头像 URL
  try {
    if ($viewed_user->hasField('user_picture') && !$viewed_user->get('user_picture')->isEmpty()) {
      $picture = $viewed_user->get('user_picture')->entity;
      if ($picture) {
        $variables['user_picture_url'] = \Drupal::service('file_url_generator')
          ->generateAbsoluteString($picture->getFileUri());
      }
    }
  } catch (\Exception $e) {}

  // 附加个人中心 CSS/JS
  $variables['#attached']['library'][] = 'xedc/page-profile';

  // 查询收藏列表
  $uid_val = (int) $viewed_user->id();
  try {
    $db = \Drupal::database();
    $cnids = $db->select('flagging', 'f')
      ->fields('f', ['entity_id'])
      ->condition('flag_id', 'collect')
      ->condition('uid', $uid_val)
      ->orderBy('created', 'DESC')
      ->range(0, 12)
      ->execute()->fetchCol();
    $variables['collected_items'] = [];
    if (!empty($cnids)) {
      foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($cnids) as $n) {
        $variables['collected_items'][] = ['title' => $n->getTitle(), 'url' => $n->toUrl()->toString(), 'bundle' => $n->bundle()];
      }
    }
  } catch (\Exception $e) { $variables['collected_items'] = []; }

  // 查询历史记录
  try {
    $hnids = $db->select('xedc_history', 'h')
      ->fields('h', ['nid'])
      ->condition('uid', $uid_val)
      ->orderBy('timestamp', 'DESC')
      ->range(0, 12)
      ->execute()->fetchCol();
    $variables['history_items'] = [];
    if (!empty($hnids)) {
      foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple($hnids) as $n) {
        $variables['history_items'][] = ['title' => $n->getTitle(), 'url' => $n->toUrl()->toString(), 'bundle' => $n->bundle()];
      }
    }
  } catch (\Exception $e) { $variables['history_items'] = []; }
}

/**
 * 强制 user 实体在 full 视图模式使用 user--full 模板
 */
function xedc_theme_suggestions_user_alter(array &$suggestions, array $variables): void {
  $view_mode = $variables['elements']['#view_mode'] ?? '';
  if ($view_mode === 'full') {
    $suggestions[] = 'user__full';
  }
}

/**
 * 为 Views 列表页附加对应的 CSS/JS 库
 */
function xedc_preprocess_views_view(array &$variables): void {
  $library_map = [
    'image_waterfall' => 'xedc/page-image-list',
    'video_list'      => 'xedc/page-video-list',
    'article_list'    => 'xedc/page-article-list',
  ];
  $view_id = $variables['view']->id();
  if (isset($library_map[$view_id])) {
    $variables['#attached']['library'][] = $library_map[$view_id];
  }

  if ($view_id !== 'article_list') {
    return;
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  $active_category = (string) ($request?->query->get('category') ?? 'all');
  $active_sort = (string) ($request?->query->get('sort') ?? 'hot');
  if ($active_category === '') {
    $active_category = 'all';
  }
  if (!in_array($active_sort, ['hot', 'new'], TRUE)) {
    $active_sort = 'hot';
  }

  $route_name = 'view.article_list.page_1';
  $base_query = [];
  if ($active_sort !== 'hot') {
    $base_query['sort'] = $active_sort;
  }

  $variables['active_category'] = $active_category;
  $variables['active_sort'] = $active_sort;
  $variables['categories'] = [];
  $variables['sort_hot_url'] = Url::fromRoute($route_name, [], [
    'query' => $active_category !== 'all' ? ['category' => $active_category] : [],
  ])->toString();
  $variables['sort_new_url'] = Url::fromRoute($route_name, [], [
    'query' => array_filter([
      'category' => $active_category !== 'all' ? $active_category : NULL,
      'sort' => 'new',
    ]),
  ])->toString();

  try {
    $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('categories', 0, NULL, FALSE);
    $variables['categories'][] = [
      'key' => 'all',
      'label' => 'All',
      'url' => Url::fromRoute($route_name, [], ['query' => $base_query])->toString(),
    ];
    foreach ($tree as $item) {
      $tid = (int) ($item->tid ?? 0);
      if (!$tid) {
        continue;
      }
      $variables['categories'][] = [
        'key' => (string) $tid,
        'label' => (string) ($item->name ?? ''),
        'url' => Url::fromRoute($route_name, [], [
          'query' => array_merge($base_query, ['category' => $tid]),
        ])->toString(),
      ];
    }
    $variables['#cache']['tags'][] = 'taxonomy_term_list:categories';
  } catch (\Exception $e) {
    $variables['categories'] = [
      [
        'key' => 'all',
        'label' => 'All',
        'url' => Url::fromRoute($route_name)->toString(),
      ],
    ];
  }

  $variables['recommended_authors'] = [];
  $variables['hot_tags'] = [];

  try {
    $nids = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('type', 'article')
      ->condition('status', 1)
      ->sort('created', 'DESC')
      ->range(0, 30)
      ->execute();

    if (!$nids) {
      return;
    }

    $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
    $file_url_generator = \Drupal::service('file_url_generator');

    $authors = [];
    $seen_uids = [];

    foreach ($nodes as $n) {
      $owner = $n->getOwner();
      if (!$owner) {
        continue;
      }
      $uid = (int) $owner->id();
      if (!$uid || isset($seen_uids[$uid])) {
        continue;
      }
      $seen_uids[$uid] = TRUE;

      $picture_url = NULL;
      if ($owner->hasField('user_picture') && !$owner->get('user_picture')->isEmpty()) {
        $picture = $owner->get('user_picture')->entity;
        if ($picture) {
          $picture_url = $file_url_generator->generateAbsoluteString($picture->getFileUri());
        }
      }

      $authors[] = [
        'uid' => $uid,
        'name' => $owner->getDisplayName(),
        'url' => $owner->toUrl()->toString(),
        'picture' => $picture_url,
      ];

      if (count($authors) >= 5) {
        break;
      }
    }

    $tag_counts = [];
    foreach ($nodes as $n) {
      if (!$n->hasField('field_tags') || $n->get('field_tags')->isEmpty()) {
        continue;
      }
      foreach ($n->get('field_tags')->referencedEntities() as $term) {
        $tid = (int) $term->id();
        if (!$tid) {
          continue;
        }
        if (!isset($tag_counts[$tid])) {
          $tag_counts[$tid] = ['term' => $term, 'count' => 0];
        }
        $tag_counts[$tid]['count']++;
      }
    }

    uasort($tag_counts, function ($a, $b) {
      return $b['count'] <=> $a['count'];
    });

    $tags = [];
    foreach ($tag_counts as $item) {
      $term = $item['term'];
      $tags[] = [
        'name' => $term->getName(),
        'url' => $term->toUrl()->toString(),
        'count' => $item['count'],
      ];
      if (count($tags) >= 10) {
        break;
      }
    }

    $variables['recommended_authors'] = $authors;
    $variables['hot_tags'] = $tags;
  } catch (\Exception $e) {}
}

function xedc_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if ($view->id() !== 'article_list') {
    return;
  }
  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  $category = $request?->query->get('category');
  if ($category && $category !== 'all' && ctype_digit((string) $category)) {
    $category_table = $query->ensureTable('node__field_category', $view->relationship);
    if ($category_table) {
      $query->addWhere(0, $category_table . '.field_category_target_id', (int) $category, '=');
    }
  }

  $sort = (string) ($request?->query->get('sort') ?? '');
  if ($sort !== 'new') {
    $view_count_table = $query->ensureTable('node__field_view_count', $view->relationship);
    if ($view_count_table) {
      $query->addOrderBy($view_count_table, 'field_view_count_value', 'DESC');
    }
  }
}

/**
 * JSON-LD 结构化数据
 */
function xedc_page_attachments_alter(array &$attachments): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node) return;

  $json_ld = [
    '@context' => 'https://schema.org',
    '@type'    => 'WebPage',
    'name'     => $node->getTitle(),
    'url'      => \Drupal::request()->getUri(),
  ];

  $attachments['#attached']['html_head'][] = [
    [
      '#tag'        => 'script',
      '#attributes' => ['type' => 'application/ld+json'],
      '#value'      => json_encode($json_ld, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES),
    ],
    'json-ld-webpage',
  ];
}
