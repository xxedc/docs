{#
  page--user--register.html.twig — 注册页（shadcn Dialog 风格）
#}
{{ attach_library('xedc/page-auth') }}
<!DOCTYPE html>
<html{{ html_attributes }}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ head_title|safe_join(' | ') }}</title>
  {{ head }}
  {{ styles }}
  {{ scripts_top }}
</head>
<body{{ attributes.addClass('xedc-body', 'xedc-body--auth') }}>
{{ page_top }}

{% set _logo_html = (site_name|default('DCXE'))|replace({'X': '<span class="xedc-logo-x">X</span>'}) %}

<div class="xedc-auth-backdrop">
  <div class="xedc-auth-dialog" role="dialog" aria-modal="true" aria-labelledby="xedc-auth-title">

    <a href="{{ url('<front>') }}" class="xedc-auth-dialog__close" aria-label="关闭，返回首页">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
      </svg>
    </a>

    <div class="xedc-auth-dialog__brand">
      <a href="{{ url('<front>') }}" class="xedc-auth-dialog__logo" aria-label="{{ site_name }}">
        {{ _logo_html|raw }}
      </a>
      <p class="xedc-auth-dialog__tagline">创建一个新账号</p>
    </div>

    <div class="xedc-auth-tabs xedc-flex" role="tablist" id="xedc-auth-title">
      <a href="/user/login"    class="xedc-auth-tab" role="tab">登录</a>
      <a href="/user/register" class="xedc-auth-tab is-active" role="tab" aria-selected="true">注册</a>
    </div>

    {% set _highlighted = page.highlighted|render|trim %}
    {% if _highlighted %}
      <div class="xedc-auth-messages" role="alert">{{ _highlighted|raw }}</div>
    {% endif %}

    <div class="xedc-auth-form-wrap">
      {{ page.content }}
    </div>

    <div class="xedc-auth-dialog__footer xedc-flex xedc-flex-between">
      <a href="/user/login" class="xedc-text-sm xedc-text-muted">已有账号？登录</a>
      <a href="{{ url('<front>') }}" class="xedc-text-sm xedc-text-muted">返回首页</a>
    </div>

  </div>
</div>

{{ page_bottom }}
{{ scripts }}
</body>
</html>
