{{ attach_library('xedc/page-profile') }}
<header class="xedc-navbar" role="banner">
  <div class="xedc-container xedc-flex xedc-flex-between" style="height:56px;">
    <a href="{{ url('<front>') }}" class="xedc-navbar__logo" aria-label="{{ site_name }}">
      <span class="xedc-navbar__logo-text">{{ site_name }}</span>
    </a>
    <nav class="xedc-navbar__nav" role="navigation" aria-label="主导航">
      {{ drupal_menu('main') }}
    </nav>
    <div class="xedc-navbar__search">
      <form action="/search" method="get" role="search">
        <input type="search" name="q" placeholder="搜索内容..." class="xedc-search-input" aria-label="全站搜索" />
        <button type="submit" class="xedc-search-btn" aria-label="搜索">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
      </form>
    </div>
    <div class="xedc-navbar__tools xedc-flex xedc-items-center xedc-gap-2">
      {% if is_logged_in %}
        <a href="/messages" class="xedc-navbar__icon-btn" aria-label="消息通知">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
        </a>
      {% endif %}
      <div class="xedc-theme-toggle" data-xedc-theme-toggle>
        <button class="xedc-navbar__icon-btn" data-xedc-theme-icon aria-label="切换主题" aria-haspopup="true" aria-expanded="false">🌙</button>
        <div class="xedc-theme-dropdown" data-xedc-theme-dropdown role="menu" aria-hidden="true">
                    <button class="xedc-theme-dropdown__item" data-xedc-theme-option="light" role="menuitemradio">☀️ Light Mode</button>
          <button class="xedc-theme-dropdown__item" data-xedc-theme-option="dark" role="menuitemradio">🌙 Soft Dark Mode</button>
                  </div>
      </div>
      {% if is_logged_in %}
        {% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}
        {% set _trigger %}
          <div class="xedc-navbar__avatar" aria-label="个人中心">
            {% if current_user_picture %}
              <img class="xedc-avatar xedc-avatar--sm xedc-avatar--img"
                   src="{{ current_user_picture }}" alt="{{ current_user_name }}" />
            {% else %}
              <div class="xedc-avatar xedc-avatar--sm"
                   style="background:oklch(0.62 0.16 {{ _hues[(current_user_name|default('U')|length) % 8] }});">
                {{ (current_user_name|default('U'))|slice(0,1)|upper }}
              </div>
            {% endif %}
          </div>
        {% endset %}
        {% set _items %}
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}">👤 个人中心</a>
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}?tab=history">🕒 浏览历史</a>
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}?tab=collects">🔖 收藏</a>
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}?tab=posts">✍️ 我的文章</a>
          <div class="xedc-dropdown__separator"></div>
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}/edit">⚙️ 设置</a>
          <a class="xedc-dropdown__item xedc-dropdown__item--destructive" href="/user/logout">退出登录</a>
        {% endset %}
        {% include 'xedc:dropdown' with { id: 'xedc-user-menu', align: 'right', trigger: _trigger, items: _items, extra_classes: 'xedc-dropdown--user' } only %}
      {% else %}
        <a href="/user/login" class="xedc-btn xedc-btn--default xedc-btn--sm">登录</a>
      {% endif %}
    </div>
  </div>
</header>

<main class="xedc-publish-page xedc-container" id="main-content">

  {% if is_logged_in %}
    <div class="xedc-publish-types">
      <h2 class="xedc-publish-types__title">选择发布类型</h2>
      <div class="xedc-publish-types__grid">

        <a href="/node/add/article" class="xedc-publish-type-card xedc-card">
          <div class="xedc-card__body" style="text-align:center;padding:var(--space-8);">
            <div style="font-size:48px;margin-bottom:var(--space-3);">📝</div>
            <h3 style="font-size:var(--text-xl);font-weight:600;margin-bottom:var(--space-2);">文章</h3>
            <p class="xedc-text-sm xedc-text-muted">文章：建议写摘要，封面图更容易被推荐</p>
          </div>
        </a>

        <a href="/node/add/video" class="xedc-publish-type-card xedc-card">
          <div class="xedc-card__body" style="text-align:center;padding:var(--space-8);">
            <div style="font-size:48px;margin-bottom:var(--space-3);">🎬</div>
            <h3 style="font-size:var(--text-xl);font-weight:600;margin-bottom:var(--space-2);">视频</h3>
            <p class="xedc-text-sm xedc-text-muted">视频：封面建议 16:9，可填写时长</p>
          </div>
        </a>

        <a href="/node/add/image_post" class="xedc-publish-type-card xedc-card">
          <div class="xedc-card__body" style="text-align:center;padding:var(--space-8);">
            <div style="font-size:48px;margin-bottom:var(--space-3);">🖼️</div>
            <h3 style="font-size:var(--text-xl);font-weight:600;margin-bottom:var(--space-2);">图集</h3>
            <p class="xedc-text-sm xedc-text-muted">图集：建议上传高清原图，设置封面更美观</p>
          </div>
        </a>

      </div>
      <div style="max-width:800px;margin:var(--space-6) auto 0;">
        <a href="/user/{{ current_user.id() }}?tab=drafts" class="xedc-btn xedc-btn--outline xedc-btn--md" style="width:100%;justify-content:center;">
          从草稿箱继续
        </a>
      </div>
    </div>
  {% else %}
    <div class="xedc-empty-state" style="min-height:60vh;">
      <div class="xedc-empty-state__icon">🔒</div>
      <h3 class="xedc-empty-state__title">请先登录</h3>
      <p class="xedc-text-sm xedc-text-muted">登录后才能发布内容</p>
      <a href="/user/login?destination=/publish"
         class="xedc-btn xedc-btn--default xedc-btn--md"
         style="margin-top:var(--space-4);">立即登录</a>
    </div>
  {% endif %}

</main>
