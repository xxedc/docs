{#
  node--video--teaser.html.twig — 视频卡片（YouTube/B站风格）
  封面图直接从 node entity 读取
#}
{% set video_url = url %}
{% set nid = node.id() %}
{% set _cover_entity = node.field_cover_image.0.entity ?? null %}
{% set _cover_file = _cover_entity and _cover_entity.fileUri is defined ? _cover_entity : (_cover_entity and _cover_entity.field_media_image is defined and _cover_entity.field_media_image.entity ? _cover_entity.field_media_image.entity : null) %}
{% set _owner = node.getOwner() %}
{% set _owner_name = _owner.getDisplayName() %}
{% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}
{% set _orientation = node.field_orientation.value %}

<article{{ attributes.addClass('xedc-video-card', _orientation == 'portrait' ? 'xedc-video-card--portrait' : '') }} data-nid="{{ nid }}">

  <a href="{{ video_url }}" class="xedc-video-card__cover" tabindex="-1">
    {% if _cover_file %}
      <img src="{{ file_url(_cover_file.fileUri) }}" alt="{{ label }}" loading="lazy" />
    {% else %}
      <div class="xedc-video-card__cover-placeholder">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
      </div>
    {% endif %}

    <div class="xedc-video-card__overlay">
      <div class="xedc-video-card__play-btn">
        <svg width="48" height="48" viewBox="0 0 48 48">
          <circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.6)"/>
          <polygon points="18 14 34 24 18 34 18 14" fill="white"/>
        </svg>
      </div>
    </div>

    {% if node.field_duration.value %}
      {% set duration = node.field_duration.value %}
      {% set minutes = (duration / 60)|round(0, 'floor') %}
      {% set seconds = duration % 60 %}
      <span class="xedc-video-card__duration">{{ minutes }}:{{ seconds < 10 ? '0' ~ seconds : seconds }}</span>
    {% endif %}

    {% set _quality = node.field_quality.value %}
    {% if _quality %}
      <span class="xedc-video-card__quality xedc-video-card__quality--{{ _quality }}">
        {%- if _quality == '4k' -%}4K
        {%- elseif _quality == '1080p' -%}1080P
        {%- elseif _quality == '720p' -%}720P
        {%- elseif _quality == '480p' -%}480P
        {%- else -%}{{ _quality }}
        {%- endif -%}
      </span>
    {% endif %}
  </a>

  <div class="xedc-video-card__body">
    <h3 class="xedc-video-card__title">
      <a href="{{ video_url }}">{{ label }}</a>
    </h3>

    <div class="xedc-video-card__meta">
      <div class="xedc-video-card__author">
        {% if _owner.user_picture.0.entity %}
          <div class="xedc-avatar xedc-avatar--xs">
            <img src="{{ file_url(_owner.user_picture.0.entity.fileUri) }}" alt="{{ _owner_name }}" />
          </div>
        {% else %}
          <div class="xedc-avatar xedc-avatar--xs"
               style="background:oklch(0.62 0.16 {{ _hues[_owner_name|length % 8] }});">
            {{ _owner_name|slice(0,1)|upper }}
          </div>
        {% endif %}
        <span class="xedc-video-card__author-name">{{ _owner_name }}</span>
      </div>
      <span class="xedc-video-card__views">{{ view_count|default(0) }} 次观看</span>
      <span class="xedc-video-card__dot">·</span>
      <span class="xedc-video-card__date">{{ node.getCreatedTime()|date('Y-m-d') }}</span>
    </div>
  </div>

</article>
