{#
  node--video--teaser.html.twig — 视频卡片（列表用）
  封面图直接从 node entity 读取
#}
{% set video_url = url %}
{% set nid = node.id() %}
{% set _cover_entity = node.field_cover_image.0.entity %}

<article{{ attributes.addClass('xedc-video-card') }} data-nid="{{ nid }}">

  {# 封面图 + 时长标签 #}
  <div class="xedc-video-card__cover">
    <a href="{{ video_url }}" class="xedc-video-card__cover-link" tabindex="-1">
      {% if _cover_entity %}
        <img src="{{ file_url(_cover_entity.fileUri) }}" alt="{{ label }}" loading="lazy" />
      {% else %}
        <div class="xedc-video-card__cover-placeholder">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
        </div>
      {% endif %}
    </a>

    {# 时长标签 #}
    {% if node.field_duration.value %}
      {% set duration = node.field_duration.value %}
      {% set minutes = (duration / 60)|round(0, 'floor') %}
      {% set seconds = duration % 60 %}
      <span class="xedc-video-card__duration">
        {{ minutes }}:{{ seconds < 10 ? '0' ~ seconds : seconds }}
      </span>
    {% endif %}

    {# 画质角标 #}
    {% set _quality = node.field_quality.value %}
    {% if _quality == '4k' %}
      <span class="xedc-badge xedc-badge--default xedc-video-card__quality" style="background:linear-gradient(135deg,oklch(0.55 0.22 27),oklch(0.5 0.2 45));">4K</span>
    {% elseif _quality == '1080p' %}
      <span class="xedc-badge xedc-badge--default xedc-video-card__quality">1080P</span>
    {% elseif _quality == '720p' %}
      <span class="xedc-badge xedc-badge--success xedc-video-card__quality">720P</span>
    {% endif %}

    {# Hover 播放按钮 #}
    <div class="xedc-video-card__play-overlay" aria-hidden="true">
      <svg width="52" height="52" viewBox="0 0 52 52">
        <circle cx="26" cy="26" r="26" fill="rgba(0,0,0,0.55)"/>
        <polygon points="21 17 38 26 21 35 21 17" fill="white"/>
      </svg>
    </div>
  </div>

  {# 信息区 #}
  <div class="xedc-video-card__info">
    <h3 class="xedc-video-card__title">
      <a href="{{ video_url }}">{{ label }}</a>
    </h3>
    <div class="xedc-video-card__meta">
      <span class="xedc-text-xs xedc-text-muted">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="display:inline;vertical-align:middle;">
          <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/>
        </svg>
        {{ view_count|default(0) }}
      </span>
      <span class="xedc-text-xs xedc-text-muted">{{ node.getCreatedTime()|date('Y-m-d') }}</span>
    </div>

    {# 快捷操作 #}
    <div class="xedc-video-card__actions">
      {% if is_logged_in %}
        <button class="xedc-icon-btn xedc-like-btn" data-nid="{{ nid }}" aria-label="点赞">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>

</article>
