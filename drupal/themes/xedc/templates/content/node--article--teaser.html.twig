{#
  node--article--teaser.html.twig — 文章卡片（竖版，列表/首页通用）
  作者信息由 xedc_preprocess_node() 预加载
#}
{% set nid = node.id() %}
{% set _owner_name = owner_name|default('') %}
{% set _owner_uid = owner_uid|default(0) %}
{% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}
{% set _cover_url = cover_image_url|default('') %}

<article{{ attributes.addClass('xedc-article-card') }}>

  {# 封面图 #}
  <div class="xedc-article-card__cover">
    <a href="{{ url }}" class="xedc-article-card__cover-link" tabindex="-1">
      {% if _cover_url %}
        <img src="{{ _cover_url }}" alt="{{ label }}" loading="lazy" />
      {% else %}
        <div class="xedc-article-card__cover-placeholder">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.4">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
        </div>
      {% endif %}
    </a>
  </div>

  {# 卡片内容区 #}
  <div class="xedc-article-card__body">

    {# 标题 #}
    <h2 class="xedc-article-card__title">
      <a href="{{ url }}">{{ label }}</a>
    </h2>

    {# 摘要（无封面图时显示）#}
    {% if node.field_summary.value and not _cover_url %}
      <p class="xedc-article-card__summary">
        {{ node.field_summary.value|slice(0, 80) }}{% if node.field_summary.value|length > 80 %}...{% endif %}
      </p>
    {% endif %}

    {# 底部信息：作者 + 元数据 #}
    <div class="xedc-article-card__footer">

      {# 作者头像 + 名字 #}
      <div class="xedc-article-card__author">
        {% if owner_picture_url %}
          <div class="xedc-avatar xedc-avatar--xs">
            <img src="{{ owner_picture_url }}" alt="{{ _owner_name }}" />
          </div>
        {% else %}
          <div class="xedc-avatar xedc-avatar--xs"
               style="background:oklch(0.62 0.16 {{ _hues[(_owner_name|length) % 8] }});color:#fff;font-size:9px;line-height:1;display:flex;align-items:center;justify-content:center;">
            {{ _owner_name|slice(0,1)|upper }}
          </div>
        {% endif %}
        <a href="/user/{{ _owner_uid }}" class="xedc-article-card__author-name">{{ _owner_name }}</a>
      </div>

      {# 元数据 #}
      <div class="xedc-article-card__meta">
        <span class="xedc-article-card__stat">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/></svg>
          {{ view_count|default(0) }}
        </span>
        {% if node.field_reading_time.value %}
          <span class="xedc-article-card__stat">
            {{ node.field_reading_time.value }}分钟
          </span>
        {% endif %}
        <span class="xedc-article-card__stat xedc-article-card__date">{{ node.getCreatedTime()|date('m-d') }}</span>
      </div>

    </div>
  </div>

</article>
