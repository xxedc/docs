{% set nid = node.id() %}
{% set owner = node.getOwner() %}
{% set owner_name = owner.getDisplayName() %}
{% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}
{% set _cover_url = teaser_cover_url|default('') %}

<article{{ attributes.addClass('xedc-article-card') }} data-nid="{{ nid }}">
  <a class="xedc-article-card__cover-link" href="{{ url }}" tabindex="-1" aria-hidden="true">
    {% if _cover_url %}
      <div class="xedc-article-card__cover">
        <img src="{{ _cover_url }}" alt="{{ label }}" loading="lazy" decoding="async" />
      </div>
    {% else %}
      <div class="xedc-article-card__cover xedc-article-card__cover--placeholder"></div>
    {% endif %}
  </a>

  <div class="xedc-article-card__body">
    <h2 class="xedc-article-card__title xedc-line-clamp-2">
      <a href="{{ url }}">{{ label }}</a>
    </h2>

    {% if node.field_summary.value %}
      <p class="xedc-article-card__summary xedc-line-clamp-3">{{ node.field_summary.value }}</p>
    {% endif %}

    <div class="xedc-article-card__author">
      {% if owner_picture_url %}
        <span class="xedc-avatar xedc-avatar--sm xedc-avatar--img">
          <img src="{{ owner_picture_url }}" alt="{{ owner_name }}" loading="lazy" />
        </span>
      {% else %}
        <span class="xedc-avatar xedc-avatar--sm xedc-avatar--h{{ _hues[owner_name|length % 8] }}">
          {{ owner_name|slice(0,1)|upper }}
        </span>
      {% endif %}
      <span class="xedc-article-card__author-text">
        <a class="xedc-article-card__author-name" href="/user/{{ node.getOwnerId() }}">{{ owner_name }}</a>
        <span class="xedc-article-card__dot">·</span>
        <time class="xedc-article-card__time" datetime="{{ node.getCreatedTime()|date('Y-m-d') }}">{{ node.getCreatedTime()|date('m-d') }}</time>
      </span>
    </div>
  </div>
</article>
