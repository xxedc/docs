{#
  node--image-post--full.html.twig — 图集详情页
  image_urls 和作者信息由 xedc_preprocess_node() 预加载
#}
{% set nid = node.id() %}
{% set _owner_name = owner_name|default('') %}
{% set _owner_uid = owner_uid|default(0) %}
{% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}
{% set _imgs = image_urls|default([]) %}

<div class="xedc-image-detail">
  <div class="xedc-container">

    {# ── 标题 ── #}
    <h1 class="xedc-image-detail__title">{{ label }}</h1>

    {# ── 作者 + 元数据 ── #}
    <div class="xedc-image-detail__meta-row">
      <div class="xedc-flex xedc-items-center xedc-gap-2">
        {% if owner_picture_url %}
          <div class="xedc-avatar xedc-avatar--sm">
            <img src="{{ owner_picture_url }}" alt="{{ _owner_name }}" />
          </div>
        {% else %}
          <div class="xedc-avatar xedc-avatar--sm"
               style="background:oklch(0.62 0.16 {{ _hues[(_owner_name|length) % 8] }});color:#fff;font-size:13px;line-height:1;display:flex;align-items:center;justify-content:center;">
            {{ _owner_name|slice(0,1)|upper }}
          </div>
        {% endif %}
        <a href="/user/{{ _owner_uid }}" class="xedc-text-sm">{{ _owner_name }}</a>
        <span class="xedc-text-sm xedc-text-muted">{{ node.getCreatedTime()|date('Y-m-d') }}</span>
        <span class="xedc-text-sm xedc-text-muted">{{ _imgs|length }} 张图片</span>
      </div>
      <div class="xedc-flex xedc-items-center xedc-gap-3">
        <span class="xedc-text-sm xedc-text-muted">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="display:inline;vertical-align:middle;">
            <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/>
          </svg>
          {{ view_count|default(0) }}
        </span>
      </div>
    </div>

    {# ── 操作栏 ── #}
    <div class="xedc-image-detail__actions">
      {% if node.field_allow_download.value and _imgs[0] is defined %}
        <a href="{{ _imgs[0] }}" download class="xedc-action-btn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          下载
        </a>
      {% endif %}
      {% if logged_in %}
        <div class="xedc-flag-btn">{{ content.flag_like is defined ? content.flag_like : '' }}</div>
        <div class="xedc-flag-btn">{{ content.flag_collect is defined ? content.flag_collect : '' }}</div>
      {% else %}
        <a href="/user/login" class="xedc-action-btn">❤️ 点赞</a>
        <a href="/user/login" class="xedc-action-btn">🔖 收藏</a>
      {% endif %}
      <button class="xedc-action-btn"
        onclick="navigator.clipboard.writeText(window.location.href).then(()=>alert('链接已复制'))">
        分享
      </button>
    </div>

    {# ── 图片展示区（瀑布/网格）── #}
    {% if _imgs %}
      <div class="xedc-image-detail__gallery">
        {% for url in _imgs %}
          <div class="xedc-image-detail__gallery-item" data-index="{{ loop.index0 }}">
            <img src="{{ url }}"
                 alt="{{ label }} - 第{{ loop.index }}张"
                 loading="lazy"
                 onclick="xedcOpenLightbox({{ loop.index0 }})" />
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="xedc-empty-state" style="padding:var(--space-12) 0;">
        <div class="xedc-empty-state__icon">🖼️</div>
        <p class="xedc-text-sm xedc-text-muted">暂无图片</p>
      </div>
    {% endif %}

    {# ── Lightbox 全屏查看 ── #}
    <div class="xedc-lightbox" id="xedc-lightbox" style="display:none;" role="dialog" aria-modal="true">
      <button class="xedc-lightbox__close" onclick="xedcCloseLightbox()" aria-label="关闭">✕</button>
      <button class="xedc-lightbox__prev" id="xedc-lb-prev" aria-label="上一张">‹</button>
      <div class="xedc-lightbox__stage">
        <img id="xedc-lb-img" src="" alt="" />
      </div>
      <button class="xedc-lightbox__next" id="xedc-lb-next" aria-label="下一张">›</button>
      <div class="xedc-lightbox__counter" id="xedc-lb-counter"></div>
    </div>

    {# 图片 URL 数据（供 JS 使用）#}
    <script>
    var xedcImageUrls = [
      {% for url in _imgs %}
        "{{ url }}"{{ loop.last ? '' : ',' }}
      {% endfor %}
    ];
    var xedcCurrentIndex = 0;

    function xedcOpenLightbox(idx) {
      xedcCurrentIndex = idx;
      xedcUpdateLightbox();
      document.getElementById('xedc-lightbox').style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    function xedcCloseLightbox() {
      document.getElementById('xedc-lightbox').style.display = 'none';
      document.body.style.overflow = '';
    }
    function xedcUpdateLightbox() {
      document.getElementById('xedc-lb-img').src = xedcImageUrls[xedcCurrentIndex];
      document.getElementById('xedc-lb-counter').textContent = (xedcCurrentIndex + 1) + ' / ' + xedcImageUrls.length;
    }
    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('xedc-lb-prev').addEventListener('click', function() {
        xedcCurrentIndex = (xedcCurrentIndex - 1 + xedcImageUrls.length) % xedcImageUrls.length;
        xedcUpdateLightbox();
      });
      document.getElementById('xedc-lb-next').addEventListener('click', function() {
        xedcCurrentIndex = (xedcCurrentIndex + 1) % xedcImageUrls.length;
        xedcUpdateLightbox();
      });
      document.addEventListener('keydown', function(e) {
        var lb = document.getElementById('xedc-lightbox');
        if (lb.style.display === 'none') return;
        if (e.key === 'Escape') xedcCloseLightbox();
        if (e.key === 'ArrowLeft') document.getElementById('xedc-lb-prev').click();
        if (e.key === 'ArrowRight') document.getElementById('xedc-lb-next').click();
      });
      document.getElementById('xedc-lightbox').addEventListener('click', function(e) {
        if (e.target === this) xedcCloseLightbox();
      });
    });
    </script>

    {# ── 简介 ── #}
    {% if content.body|render|trim %}
      <div class="xedc-image-detail__desc xedc-article__body">{{ content.body }}</div>
    {% endif %}

    {# ── 标签 ── #}
    {% if content.field_tags|render|trim %}
      <div class="xedc-image-detail__tags" style="margin-top:var(--space-4);">
        {{ content.field_tags }}
      </div>
    {% endif %}

    {# ── 相关推荐 ── #}
    <div class="xedc-image-detail__related" style="margin-top:var(--space-8);">
      <h3 class="xedc-sidebar__title">相关图集</h3>
      {{ drupal_view('image_waterfall', 'block_1') }}
    </div>

  </div>
</div>
