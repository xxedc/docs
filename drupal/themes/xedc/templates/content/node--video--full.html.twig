{#
  node--video--full.html.twig — 视频详情页（Flag版点赞收藏）
#}
{% set nid = node.id() %}

<div class="xedc-video-detail">
  <div class="xedc-container">
    <div class="xedc-video-detail__layout">

      <div class="xedc-video-detail__main">

        {# 播放器 #}
        <div class="xedc-video-player" id="xedc-video-player">
          {% if node.field_video_file.entity %}
            <video class="xedc-video-player__video" controls preload="metadata"
                   data-nid="{{ nid }}">
              <source src="{{ file_url(node.field_video_file.entity.fileUri) }}" type="video/mp4" />
            </video>
          {% elseif node.field_video_url.uri %}
            <div class="xedc-video-player__external">
              <a href="{{ node.field_video_url.uri }}" target="_blank" rel="noopener"
                 class="xedc-btn xedc-btn--default xedc-btn--lg">▶ 打开外部视频</a>
            </div>
          {% else %}
            <div class="xedc-video-player__placeholder">
              {{ content.field_cover_image }}
            </div>
          {% endif %}
        </div>

        {# 视频信息 #}
        <div class="xedc-video-detail__info">
          <h1 class="xedc-video-detail__title">{{ label }}</h1>
          <div class="xedc-video-detail__meta xedc-flex xedc-items-center xedc-gap-4">
            <span class="xedc-text-sm xedc-text-muted">👁 {{ view_count|default(0) }} 次播放</span>
            <span class="xedc-text-sm xedc-text-muted">{{ node.getCreatedTime()|date('Y年m月d日') }}</span>
            {% if node.field_quality.value %}
              <span class="xedc-badge xedc-badge--secondary">{{ node.field_quality.value|upper }}</span>
            {% endif %}
          </div>

          {# 互动操作栏 — Flag 模块 #}
          <div class="xedc-video-detail__actions xedc-flex xedc-items-center xedc-gap-3"
               style="margin: var(--space-4) 0;">
            {% if logged_in %}
              {# 点赞 Flag 链接 #}
              <div class="xedc-flag-btn">
                {{ content.flag_like is defined ? content.flag_like : '' }}
              </div>
              {# 收藏 Flag 链接 #}
              <div class="xedc-flag-btn">
                {{ content.flag_collect is defined ? content.flag_collect : '' }}
              </div>
            {% else %}
              <a href="/user/login" class="xedc-action-btn">❤️ 点赞</a>
              <a href="/user/login" class="xedc-action-btn">🔖 收藏</a>
            {% endif %}

            <button class="xedc-action-btn"
              onclick="navigator.clipboard.writeText(window.location.href);alert('链接已复制')">
              分享
            </button>
            <button class="xedc-action-btn" onclick="alert('敬请期待')">投币</button>
          </div>

          {# 简介 #}
          {% if content.body %}
            <details class="xedc-video-detail__desc">
              <summary>视频简介</summary>
              <div>{{ content.body }}</div>
            </details>
          {% endif %}

          {% if content.field_tags %}
            <div class="xedc-flex xedc-gap-2" style="flex-wrap:wrap;margin-top:var(--space-3);">
              {{ content.field_tags }}
            </div>
          {% endif %}
        </div>

        {# 评论区 #}
        <div class="xedc-comments" style="margin-top:var(--space-8);">
          <h3 class="xedc-comments__title">评论</h3>
          {% if logged_in %}
            <div class="xedc-comment-form">
              <textarea class="xedc-input" style="height:80px;resize:vertical;width:100%;"
                        placeholder="写下你的评论..."></textarea>
              <button class="xedc-btn xedc-btn--default xedc-btn--sm"
                      style="margin-top:var(--space-2);"
                      onclick="alert('评论功能阶段5完善')">发表评论</button>
            </div>
          {% else %}
            <p class="xedc-text-sm xedc-text-muted"><a href="/user/login">登录</a>后发表评论</p>
          {% endif %}
        </div>

      </div>

      {# 右侧推荐 #}
      <aside class="xedc-video-detail__sidebar">
        <h3 class="xedc-sidebar__title">相关视频</h3>
        {{ drupal_view('video_list', 'block_1') }}
      </aside>

    </div>
  </div>
</div>
