{#
  node--image-post--teaser.html.twig — 图集卡片（瀑布流用）
  封面图直接从 node entity 读取
#}
{% set nid = node.id() %}
{% set _cover_entity = node.field_cover_image.0.entity %}
{% set _first_image = node.field_images.0.entity ?? node.field_image.0.entity %}
{% set _owner = node.getOwner() %}
{% set _owner_name = _owner.getDisplayName() %}
{% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}

<article{{ attributes.addClass('xedc-image-card') }} data-nid="{{ nid }}" data-selectable>

  {# 图片主体 #}
  <div class="xedc-image-card__img-wrap">
    <a href="{{ url }}" class="xedc-image-card__link">
      {% if _cover_entity %}
        <img src="{{ file_url(_cover_entity.fileUri) }}" alt="{{ label }}" loading="lazy" />
      {% elseif _first_image %}
        <img src="{{ file_url(_first_image.fileUri) }}" alt="{{ label }}" loading="lazy" />
      {% else %}
        <div class="xedc-image-card__placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        </div>
      {% endif %}
    </a>

    {# Hover 操作浮层 #}
    <div class="xedc-image-card__overlay" aria-hidden="true">
      <div class="xedc-image-card__overlay-actions">
        {% if is_logged_in %}
          <button class="xedc-icon-btn xedc-collect-btn" data-nid="{{ nid }}" aria-label="收藏">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </button>
        {% endif %}
        {% if node.field_allow_download.value %}
          <a href="{{ url }}?download=1" class="xedc-icon-btn" aria-label="下载">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>
        {% endif %}
      </div>

      {# 多选复选框 #}
      <label class="xedc-image-card__checkbox" style="display:none;">
        <input type="checkbox" class="xedc-select-item" value="{{ nid }}" aria-label="选择此图片" />
      </label>
    </div>
  </div>

  {# 图集信息 #}
  <div class="xedc-image-card__info">
    <span class="xedc-type-badge xedc-type-badge--image">图片</span>
    <a href="{{ url }}" class="xedc-image-card__title">{{ label }}</a>

    {# 发布者信息：左侧头像+名称，右侧时间 #}
    <div class="xedc-image-card__author">
      {% if _owner.user_picture.0.entity %}
        <div class="xedc-avatar xedc-avatar--xs">
          <img src="{{ file_url(_owner.user_picture.0.entity.fileUri) }}" alt="{{ _owner_name }}" />
        </div>
      {% else %}
        <div class="xedc-avatar xedc-avatar--xs"
             style="background:oklch(0.62 0.16 {{ _hues[_owner_name|length % 8] }});">
          {{ _owner_name|slice(0,1)|upper }}
        </div>
      {% endif %}
      <a href="/user/{{ node.getOwnerId() }}" class="xedc-image-card__author-name">{{ _owner_name }}</a>
      <span class="xedc-text-xs xedc-text-muted" style="margin-left:auto;">{{ node.getCreatedTime()|date('m-d') }}</span>
    </div>

    <div class="xedc-image-card__meta">
      <span class="xedc-text-xs xedc-text-muted">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" style="display:inline;vertical-align:middle;margin-right:2px;">
          <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/>
        </svg>
        {{ view_count|default(0) }}
      </span>
    </div>
  </div>

</article>
