{#
  node--image-post--teaser.html.twig — 图集卡片（瀑布流用）
  封面图直接从 node entity 读取
#}
{% set nid = node.id() %}
{% set _cover_entity = node.field_cover_image.0.entity %}
{% set _first_image = node.field_image.0.entity %}
{% set _owner = node.getOwner() %}
{% set _owner_name = _owner.getDisplayName() %}
{% set _view = view_count|default(0) %}
{% set _like = like_count|default(0) %}
{% set _now = "now"|date("U") %}
{% set _is_new = (_now - node.getCreatedTime()) < 86400 %}
{% set _is_hot = _view >= 20000 %}
{% set _tags = tag_names|default([]) %}

<article{{ attributes.addClass('xedc-image-card') }} data-nid="{{ nid }}" data-selectable>

  {# 图片主体 #}
  <div class="xedc-image-card__img-wrap">
    <a href="{{ url }}" class="xedc-image-card__link">
      {% if _cover_entity %}
        <img src="{{ file_url(_cover_entity.fileUri) }}" alt="{{ label }}" loading="lazy" />
      {% elseif _first_image %}
        <img src="{{ file_url(_first_image.fileUri) }}" alt="{{ label }}" loading="lazy" />
      {% else %}
        <div class="xedc-image-card__placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        </div>
      {% endif %}
    </a>

    <div class="xedc-image-card__top">
      <div class="xedc-image-card__badges">
        {% if _is_hot %}
          <span class="xedc-image-badge xedc-image-badge--hot">HOT</span>
        {% endif %}
        {% if _is_new %}
          <span class="xedc-image-badge xedc-image-badge--new">NEW</span>
        {% endif %}
      </div>
    </div>

    {% if _tags %}
      <div class="xedc-image-card__tags">
        {% for t in _tags|slice(0, 2) %}
          <span class="xedc-image-tag">#{{ t }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {# Hover 操作浮层 #}
    <div class="xedc-image-card__overlay" aria-hidden="true">
      <div class="xedc-image-card__overlay-actions">
        {% if is_logged_in %}
          <button class="xedc-icon-btn xedc-collect-btn" data-nid="{{ nid }}" aria-label="收藏">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </button>
        {% endif %}
        {% if node.field_allow_download.value %}
          <a href="{{ path('xedc_core.image_post_download', {'nid': nid}) }}" class="xedc-icon-btn" aria-label="下载">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>
        {% endif %}
      </div>

      {# 多选复选框 #}
      <label class="xedc-image-card__checkbox" style="display:none;">
        <input type="checkbox" class="xedc-select-item" value="{{ nid }}" aria-label="选择此图片" />
      </label>
    </div>
  </div>

  {# 图集信息 #}
  <div class="xedc-image-card__info">
    <a href="{{ url }}" class="xedc-image-card__title">{{ label }}</a>

    {# 发布者信息 #}
    <div class="xedc-image-card__author">
      {% include 'xedc:avatar' with {
        size: 'xs',
        src: owner_picture_url|default(null),
        name: _owner_name,
        url: '/user/' ~ node.getOwnerId()
      } only %}
      <a href="/user/{{ node.getOwnerId() }}" class="xedc-image-card__author-name">{{ _owner_name }}</a>
      <time class="xedc-image-card__date xedc-text-xs xedc-text-muted" datetime="{{ node.getCreatedTime()|date('c') }}">
        {{ node.getCreatedTime()|relative_time }}
      </time>
    </div>

    <div class="xedc-image-card__meta">
      <span class="xedc-meta-item" aria-label="浏览量">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
        <span>{{ _view|view_count_format }}</span>
      </span>
      <span class="xedc-meta-item" aria-label="点赞数">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <span>{{ _like|view_count_format }}</span>
      </span>
    </div>
  </div>

</article>
