{#
  node--image-post--teaser.html.twig — 图集卡片（优化版）
  修复：头像显示、链接跳转、作者信息完整
#}
{% set nid = node.id() %}
{% set _cover_entity = node.field_cover_image.0.entity %}
{% set _first_image = node.field_images.0.entity %}
{% set _owner = node.getOwner() %}
{% set _owner_name = _owner.getDisplayName() %}
{% set _owner_uid = _owner.id() %}
{% set _owner_picture = _owner.hasField('user_picture') and not _owner.get('user_picture').isEmpty() ? file_url(_owner.get('user_picture').0.entity.fileUri) : null %}
{% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}

<article{{ attributes.addClass('xedc-image-card') }} data-nid="{{ nid }}" data-selectable>

  {# 图片主体 - 完整链接到内容页 #}
  <div class="xedc-image-card__img-wrap">
    <a href="{{ url }}" class="xedc-image-card__link" title="{{ label }}">
      {% if _cover_entity %}
        <img src="{{ file_url(_cover_entity.fileUri) }}" alt="{{ label }}" loading="lazy" />
      {% elseif _first_image %}
        <img src="{{ file_url(_first_image.fileUri) }}" alt="{{ label }}" loading="lazy" />
      {% else %}
        <div class="xedc-image-card__placeholder">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.5">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <polyline points="21 15 16 10 5 21"/>
          </svg>
        </div>
      {% endif %}
    </a>

    {# Hover 操作浮层 #}
    <div class="xedc-image-card__overlay" aria-hidden="true">
      <div class="xedc-image-card__overlay-actions">
        {% if is_logged_in %}
          <button class="xedc-icon-btn xedc-collect-btn" data-nid="{{ nid }}" aria-label="收藏">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
            </svg>
          </button>
        {% endif %}
        {% if node.field_allow_download.value %}
          <a href="{{ url }}?download=1" class="xedc-icon-btn" aria-label="下载">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
          </a>
        {% endif %}
      </div>
      <label class="xedc-image-card__checkbox" style="display:none;">
        <input type="checkbox" data-nid="{{ nid }}" />
      </label>
    </div>
  </div>

  {# 信息区 - 显示作者头像 + 标题 + 元数据 #}
  <div class="xedc-image-card__info">
    <h3 class="xedc-image-card__title">
      <a href="{{ url }}">{{ label }}</a>
    </h3>

    {# 发布者信息 - 修复头像显示 #}
    <div class="xedc-image-card__author">
      {% if _owner_picture %}
        <div class="xedc-avatar xedc-avatar--img">
          <img src="{{ _owner_picture }}" alt="{{ _owner_name }}" />
        </div>
      {% else %}
        <div class="xedc-avatar" style="background:oklch(0.62 0.16 {{ _hues[_owner_name|length % 8] }});">
          {{ _owner_name|slice(0,1)|upper }}
        </div>
      {% endif %}
      <a href="/user/{{ _owner_uid }}" class="xedc-image-card__author-name">{{ _owner_name }}</a>
    </div>

    {% if node.hasField('created') %}
      <div class="xedc-image-card__meta">
        <span class="xedc-text-xs xedc-text-muted">{{ node.getCreatedTime()|date('Y-m-d') }}</span>
      </div>
    {% endif %}
  </div>
</article>
