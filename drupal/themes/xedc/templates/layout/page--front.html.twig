<!DOCTYPE html>
<html{{ html_attributes }}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ head_title|safe_join(' | ') }}</title>
  {{ head }}
  {{ styles }}
  {{ scripts_top }}
</head>
<body{{ attributes.addClass('xedc-body', 'xedc-body--front') }}>
{{ page_top }}

<div class="xedc-front-shell">
  <aside class="xedc-left-rail">
    <div class="xedc-left-rail__brand">{{ site_name }}</div>
    <nav class="xedc-left-rail__nav">
      <a href="/" class="is-active">首页</a><a href="/images">图片</a><a href="/videos">视频</a><a href="/articles">文章</a><a href="/topics">热门话题</a>
    </nav>
  </aside>

  <div class="xedc-front-main-wrap">
    <header class="xedc-navbar" role="banner"><div class="xedc-container xedc-flex xedc-flex-between" style="height:56px;"><a href="{{ url('<front>') }}" class="xedc-navbar__logo">{{ site_name }}</a><nav class="xedc-navbar__nav">{{ drupal_menu('main') }}</nav><div class="xedc-navbar__search"><form action="/search" method="get"><input type="search" name="q" placeholder="搜索图片、视频、文章、用户..." class="xedc-search-input" /></form></div><div class="xedc-navbar__tools"><a href="/user/login" class="xedc-btn xedc-btn--default xedc-btn--sm">登录 / 注册</a></div></div></header>

    <section class="xedc-front__banner"><div class="xedc-container">{{ drupal_view('front_banner', 'block_1') }}</div></section>
    <section class="xedc-front__categories"><div class="xedc-container"><div class="xedc-category-nav"><a href="/images" class="xedc-category-nav__item">图片</a><a href="/videos" class="xedc-category-nav__item">视频</a><a href="/articles" class="xedc-category-nav__item">文章</a><a href="/topics" class="xedc-category-nav__item">热门话题</a></div></div></section>

    <div class="xedc-front__layout xedc-container">
      <main class="xedc-front__main"><div class="xedc-front__section-title"><h2>推荐内容</h2></div>{{ drupal_view('front_recommend', 'default') }}</main>
      <aside class="xedc-front__sidebar"><div class="xedc-sidebar__widget"><h3 class="xedc-sidebar__title">推荐内容</h3>{{ drupal_view('hot_rank', 'block_1') }}</div></aside>
    </div>

    <footer class="xedc-footer"><div class="xedc-container"><p class="xedc-text-xs xedc-text-muted">© {{ "now"|date("Y") }} {{ site_name }}. All rights reserved.</p></div></footer>
  </div>
</div>

<nav class="xedc-mobile-tabbar"><a href="/">首页</a><a href="/topics">分类</a><a href="/publish" class="is-plus">+</a><a href="/messages">消息</a><a href="/user">我的</a></nav>

{{ page_bottom }}
{{ scripts }}
</body>
</html>
