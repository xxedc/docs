{#
  page--front.html.twig — 首页（统一布局）
  PC：左侧 240px 固定侧边栏 + 主内容（含顶部导航 + banner + 推荐 + 话题 + footer）
  移动：顶部 navbar（汉堡 + logo + 搜索 + 工具）+ 内容 + 底部 tabbar
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ head_title|safe_join(' | ') }}</title>
  {{ head }}
  {{ styles }}
  {{ scripts_top }}
</head>
<body{{ attributes.addClass('xedc-body', 'xedc-body--front') }}>
{{ page_top }}

{# ── PC 左侧固定侧边栏（全站统一）── #}
<aside class="xedc-gsidebar" aria-label="侧边导航">
  <div class="xedc-gsidebar__logo">
    <a href="{{ url('<front>') }}">{{ site_name }}</a>
  </div>
  <nav class="xedc-gsidebar__nav" role="navigation" aria-label="主导航">
    <a href="{{ url('<front>') }}" class="xedc-gsidebar__navitem is-active">
      <svg class="xedc-gsidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
      首页
    </a>
    <a href="/images" class="xedc-gsidebar__navitem">
      <svg class="xedc-gsidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15 16 10 5 21"/></svg>
      图片
    </a>
    <a href="/videos" class="xedc-gsidebar__navitem">
      <svg class="xedc-gsidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m16 13 5.223 3.482A1 1 0 0 0 23 15.65V8.35a1 1 0 0 0-1.777-.832L16 11V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-3z"/></svg>
      视频
    </a>
    <a href="/articles" class="xedc-gsidebar__navitem">
      <svg class="xedc-gsidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></svg>
      文章
    </a>
    <a href="/topics" class="xedc-gsidebar__navitem">
      <svg class="xedc-gsidebar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
      热门话题
    </a>
  </nav>

  <div class="xedc-gsidebar__group">
    <p class="xedc-gsidebar__group-label">分类</p>
    <a href="/images?f[0]=category:anime"     class="xedc-gsidebar__catitem">二次元</a>
    <a href="/images?f[0]=category:wallpaper" class="xedc-gsidebar__catitem">动漫壁纸</a>
    <a href="/images?f[0]=category:cosplay"   class="xedc-gsidebar__catitem">Cosplay</a>
    <a href="/images?f[0]=category:photo"     class="xedc-gsidebar__catitem">写真美图</a>
    <a href="/images?f[0]=category:gamecg"    class="xedc-gsidebar__catitem">游戏CG</a>
    <a href="/images?f[0]=category:landscape" class="xedc-gsidebar__catitem">风景建筑</a>
    <a href="/categories" class="xedc-gsidebar__catitem xedc-gsidebar__catitem--more">··· 更多分类</a>
  </div>

  {% if is_logged_in %}
  <div class="xedc-gsidebar__group">
    <p class="xedc-gsidebar__group-label">我的</p>
    <a href="/user/{{ current_user.id() }}?tab=collects" class="xedc-gsidebar__catitem">收藏</a>
    <a href="/user/{{ current_user.id() }}?tab=history"  class="xedc-gsidebar__catitem">历史浏览</a>
    <a href="/user/{{ current_user.id() }}?tab=posts"    class="xedc-gsidebar__catitem">我的发布</a>
  </div>
  {% endif %}

  <div class="xedc-gsidebar__upload">
    <a href="/publish" class="xedc-gsidebar__upload-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      上传创作
    </a>
    <span class="xedc-gsidebar__upload-hint">分享你的作品</span>
  </div>
</aside>

<div class="xedc-page-body">

{# ── 顶部导航栏（与全站统一）── #}
<header class="xedc-navbar" role="banner">
  <div class="xedc-container xedc-flex xedc-flex-between" style="height:56px; gap: var(--space-3);">
    <button class="xedc-navbar__menu-btn" onclick="xedcOpenShell()" aria-label="打开菜单">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    <a href="{{ url('<front>') }}" class="xedc-navbar__logo" aria-label="{{ site_name }}">
      <span class="xedc-navbar__logo-text">{{ site_name }}</span>
    </a>
    <nav class="xedc-navbar__nav" role="navigation" aria-label="主导航">
      {{ drupal_menu('main') }}
    </nav>
    <div class="xedc-navbar__search">
      <form action="/search" method="get" role="search">
        <input type="search" name="q" placeholder="搜索图片、视频、文章..." class="xedc-search-input" aria-label="全站搜索" />
        <button type="submit" class="xedc-search-btn" aria-label="搜索">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
      </form>
    </div>
    <div class="xedc-navbar__tools xedc-flex xedc-items-center xedc-gap-2">
      <a href="/publish" class="xedc-btn xedc-btn--default xedc-btn--sm xedc-navbar__publish">发布</a>
      {% if is_logged_in %}
        <a href="/messages" class="xedc-navbar__icon-btn" aria-label="消息通知">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
        </a>
      {% endif %}
      {% include 'xedc:theme-toggle' %}
      {% if is_logged_in %}
        {% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}
        {% set _trigger %}
          <div class="xedc-navbar__avatar" aria-label="个人中心">
            {% if current_user_picture %}
              <img class="xedc-avatar xedc-avatar--sm xedc-avatar--img"
                   src="{{ current_user_picture }}" alt="{{ current_user_name }}" />
            {% else %}
              <div class="xedc-avatar xedc-avatar--sm"
                   style="background:oklch(0.62 0.16 {{ _hues[(current_user_name|default('U')|length) % 8] }});">
                {{ (current_user_name|default('U'))|slice(0,1)|upper }}
              </div>
            {% endif %}
          </div>
        {% endset %}
        {% set _items %}
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            个人中心
          </a>
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}?tab=history">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l3 2"/></svg>
            浏览历史
          </a>
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}?tab=collects">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            收藏
          </a>
          <div class="xedc-dropdown__separator"></div>
          <a class="xedc-dropdown__item" href="/user/{{ current_user.id() }}/edit">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93A10 10 0 0 1 21.25 9m-2.18-4.07C17.16 3.41 14.68 2.5 12 2.5c-5.25 0-9.5 4.25-9.5 9.5 0 2.68.91 5.16 2.43 7.07M19.07 4.93C20.59 6.84 21.5 9.32 21.5 12c0 5.25-4.25 9.5-9.5 9.5-2.68 0-5.16-.91-7.07-2.43"/></svg>
            设置
          </a>
          <a class="xedc-dropdown__item xedc-dropdown__item--destructive" href="/user/logout">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            退出登录
          </a>
        {% endset %}
        {% include 'xedc:dropdown' with { id:'xedc-user-menu', align:'right', trigger:_trigger, items:_items, extra_classes:'xedc-dropdown--user' } only %}
      {% else %}
        <a href="/user/login" class="xedc-btn xedc-btn--primary xedc-btn--sm">登录</a>
      {% endif %}
    </div>
  </div>
</header>

{# ── 主内容 ── #}
<main class="xedc-front-main xedc-container" id="main-content" role="main">

  {# Banner 精选区 #}
  <section class="xedc-front__banner-wrap" aria-label="精选内容">
    {{ drupal_view('front_banner', 'block_1') }}
  </section>

  {# 内容类型 Tabs #}
  <nav class="xedc-content-tabs" aria-label="内容类型">
    <a href="/images" class="xedc-content-tab is-active">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15 16 10 5 21"/></svg>
      图片
    </a>
    <a href="/videos" class="xedc-content-tab">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m16 13 5.223 3.482A1 1 0 0 0 23 15.65V8.35a1 1 0 0 0-1.777-.832L16 11V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-3z"/></svg>
      视频
    </a>
    <a href="/articles" class="xedc-content-tab">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8"/></svg>
      文章
    </a>
    <a href="/topics" class="xedc-content-tab">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.59 13.41 12 22l-8-8V4h10l6.59 9.41z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
      热门话题
    </a>
  </nav>

  {# 推荐内容 #}
  <section class="xedc-front__section">
    <div class="xedc-front__section-hd">
      <h2 class="xedc-section-title">推荐内容</h2>
      <div class="xedc-filter-tabs" id="xedc-filter-tabs">
        <button class="xedc-filter-tab is-active" data-filter="recommend">推荐</button>
        <button class="xedc-filter-tab" data-filter="latest">最新</button>
        <button class="xedc-filter-tab" data-filter="hot">最热</button>
      </div>
      <a href="/images" class="xedc-more-link">
        查看更多
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </div>
    {{ drupal_view('front_recommend', 'default') }}
  </section>

  {# 热门话题 #}
  <section class="xedc-front__section">
    <div class="xedc-front__section-hd">
      <h2 class="xedc-section-title">热门话题</h2>
      <a href="/topics" class="xedc-more-link">
        查看更多
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </div>
    <div class="xedc-topics-wrap">
      {{ drupal_view('hot_topics', 'block_1') }}
    </div>
  </section>

</main>

{# ── Footer ── #}
<footer class="xedc-footer" role="contentinfo">
  <div class="xedc-container">
    <nav class="xedc-footer__nav" aria-label="底部链接">{{ drupal_menu('footer') }}</nav>
    <div class="xedc-footer__bottom">
      <p class="xedc-text-xs xedc-text-muted">© {{ "now"|date("Y") }} {{ site_name }}. All rights reserved.</p>
    </div>
  </div>
</footer>

</div>{# end .xedc-page-body #}

{# ── 移动端抽屉（全站统一）── #}
<div class="xedc-shell-overlay" id="xedc-shell-overlay" onclick="xedcCloseShell()"></div>
<aside class="xedc-shell-drawer" id="xedc-shell-drawer" aria-label="侧边导航">
  <a href="{{ url('<front>') }}" class="xedc-shell-drawer__brand">{{ site_name }}</a>
  <nav class="xedc-shell-drawer__nav">
    <a href="{{ url('<front>') }}" class="xedc-shell-drawer__item is-active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
      首页
    </a>
    <a href="/images" class="xedc-shell-drawer__item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15 16 10 5 21"/></svg>
      图片
    </a>
    <a href="/videos" class="xedc-shell-drawer__item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m16 13 5.223 3.482A1 1 0 0 0 23 15.65V8.35a1 1 0 0 0-1.777-.832L16 11V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-3z"/></svg>
      视频
    </a>
    <a href="/articles" class="xedc-shell-drawer__item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
      文章
    </a>
    <a href="/topics" class="xedc-shell-drawer__item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
      热门话题
    </a>
  </nav>
  {% if is_logged_in %}
  <div class="xedc-shell-drawer__group">
    <div class="xedc-shell-drawer__group-label">我的</div>
    <div class="xedc-shell-drawer__sublist">
      <a href="/user/{{ current_user.id() }}?tab=collects" class="xedc-shell-drawer__subitem">收藏</a>
      <a href="/user/{{ current_user.id() }}?tab=history"  class="xedc-shell-drawer__subitem">浏览历史</a>
      <a href="/user/{{ current_user.id() }}?tab=posts"    class="xedc-shell-drawer__subitem">我的发布</a>
    </div>
  </div>
  {% endif %}
</aside>

{# ── 移动端底部 tabbar（全站统一）── #}
<nav class="xedc-shell-bottom-nav" aria-label="底部导航">
  <a class="xedc-shell-bottom-nav__item is-active" href="{{ url('<front>') }}">
    <span class="xedc-shell-bottom-nav__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></span>
    <span class="xedc-shell-bottom-nav__text">首页</span>
  </a>
  <a class="xedc-shell-bottom-nav__item" href="/images">
    <span class="xedc-shell-bottom-nav__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15 16 10 5 21"/></svg></span>
    <span class="xedc-shell-bottom-nav__text">分类</span>
  </a>
  <a class="xedc-shell-bottom-nav__publish" href="/publish" aria-label="发布">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
  </a>
  <a class="xedc-shell-bottom-nav__item" href="/messages">
    <span class="xedc-shell-bottom-nav__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a4 4 0 0 1-4 4H7l-4 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg></span>
    <span class="xedc-shell-bottom-nav__text">消息</span>
  </a>
  <a class="xedc-shell-bottom-nav__item" href="{% if is_logged_in %}/user/{{ current_user.id() }}{% else %}/user/login{% endif %}">
    <span class="xedc-shell-bottom-nav__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
    <span class="xedc-shell-bottom-nav__text">我的</span>
  </a>
</nav>

{{ page_bottom }}
{{ scripts }}
</body>
</html>
