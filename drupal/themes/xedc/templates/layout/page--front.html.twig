{#
  page--front.html.twig — 首页专用模板
#}
<!DOCTYPE html>
<html{{ html_attributes }}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ head_title|safe_join(' | ') }}</title>
  {{ head }}
  {{ styles }}
  {{ scripts_top }}
</head>
<body{{ attributes.addClass('xedc-body', 'xedc-body--front') }}>
{{ page_top }}

<header class="xedc-navbar" role="banner">
  <div class="xedc-container xedc-flex xedc-flex-between" style="height:56px;">
    <a href="{{ url('<front>') }}" class="xedc-navbar__logo" aria-label="{{ site_name }}">
      <span class="xedc-navbar__logo-text">{{ site_name }}</span>
    </a>

    <nav class="xedc-navbar__nav" role="navigation" aria-label="主导航">
      {{ drupal_menu('main') }}
    </nav>

    <div class="xedc-navbar__search">
      <form action="/search" method="get" role="search">
        <input type="search" name="q" placeholder="搜索视频、图片、文章..." class="xedc-search-input" aria-label="全站搜索" />
        <button type="submit" class="xedc-search-btn" aria-label="搜索">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
      </form>
    </div>

    <div class="xedc-navbar__tools xedc-flex xedc-items-center xedc-gap-2">
      {% if is_logged_in %}
        <a href="/messages" class="xedc-navbar__icon-btn" aria-label="消息通知">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
        </a>
      {% endif %}
      {% include 'xedc:theme-toggle' %}
      {% if is_logged_in %}
        {% set _hues = [220, 280, 155, 30, 340, 190, 320, 55] %}
        <a href="/user/{{ current_user.id() }}" class="xedc-navbar__avatar" aria-label="个人中心">
          {% if current_user_picture %}
            <img class="xedc-avatar xedc-avatar--sm xedc-avatar--img" src="{{ current_user_picture }}" alt="{{ current_user_name }}" />
          {% else %}
            <div class="xedc-avatar xedc-avatar--sm"
                 style="background:oklch(0.62 0.16 {{ _hues[(current_user_name|default('U')|length) % 8] }});">
              {{ (current_user_name|default('U'))|slice(0,1)|upper }}
            </div>
          {% endif %}
        </a>
      {% else %}
        <a href="/user/login" class="xedc-btn xedc-btn--default xedc-btn--sm">登录</a>
      {% endif %}
    </div>
  </div>
</header>

{% if page.highlighted %}
  <div class="xedc-highlighted xedc-container" role="alert">{{ page.highlighted }}</div>
{% endif %}

<section class="xedc-front-hero">
  <div class="xedc-container">
    <div class="xedc-front-hero__card">
      <div class="xedc-front-hero__content">
        <span class="xedc-front-hero__eyebrow">Media Hub</span>
        <h1 class="xedc-front-hero__title">{{ site_name }}</h1>
        <p class="xedc-front-hero__subtitle">
          {{ site_slogan|default('视频、图片、文章统一浏览。更清爽的首页，更快的发现内容。') }}
        </p>

        <form action="/search" method="get" class="xedc-front-hero__search" role="search">
          <input type="search" name="q" class="xedc-search-input" placeholder="搜索你想看的内容..." aria-label="搜索内容" />
          <button type="submit" class="xedc-btn xedc-btn--default xedc-btn--md">立即搜索</button>
        </form>

        <div class="xedc-front-hero__stats">
          <div class="xedc-front-hero__stat">
            <strong>视频</strong>
            <span>精选播放</span>
          </div>
          <div class="xedc-front-hero__stat">
            <strong>图片</strong>
            <span>瀑布浏览</span>
          </div>
          <div class="xedc-front-hero__stat">
            <strong>文章</strong>
            <span>深度阅读</span>
          </div>
        </div>
      </div>

      <aside class="xedc-front-hero__aside">
        <div class="xedc-front-hero__panel">
          <h3>今日推荐</h3>
          <p>首页内容已经按“综合门户”方式拆分为：顶部精选、分类入口、主推荐流和侧栏热榜。</p>
          <a href="#main-content" class="xedc-btn xedc-btn--outline xedc-btn--sm">进入内容区</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="xedc-front__banner">
  <div class="xedc-container">
    <div class="xedc-section-head">
      <h2>精选推荐</h2>
      <span>横向浏览重点内容</span>
    </div>
    {{ drupal_view('front_banner', 'block_1') }}
  </div>
</section>

<section class="xedc-front__categories">
  <div class="xedc-container">
    <div class="xedc-category-nav" id="xedc-category-nav">
      <a href="/videos" class="xedc-category-nav__item">
        <span class="xedc-category-nav__icon">🎬</span>
        <span>视频</span>
      </a>
      <a href="/images" class="xedc-category-nav__item">
        <span class="xedc-category-nav__icon">🖼️</span>
        <span>图片</span>
      </a>
      <a href="/articles" class="xedc-category-nav__item">
        <span class="xedc-category-nav__icon">📝</span>
        <span>文章</span>
      </a>
      <a href="/topics" class="xedc-category-nav__item">
        <span class="xedc-category-nav__icon">🏷️</span>
        <span>话题</span>
      </a>
    </div>
  </div>
</section>

<div class="xedc-front__layout xedc-container">
  <main class="xedc-front__main" id="main-content" role="main">
    <div class="xedc-section-head">
      <h2>推荐内容</h2>
      <span>文章、图片、视频混合流</span>
    </div>
    {{ drupal_view('front_recommend', 'default') }}
  </main>

  <aside class="xedc-front__sidebar" role="complementary">
    <div class="xedc-sidebar__widget">
      <h3 class="xedc-sidebar__title">🔥 热门榜单</h3>
      {{ drupal_view('hot_rank', 'block_1') }}
    </div>

    <div class="xedc-sidebar__widget">
      <h3 class="xedc-sidebar__title">快捷入口</h3>
      <div class="xedc-sidebar-links">
        <a href="/videos">视频频道</a>
        <a href="/images">图片频道</a>
        <a href="/articles">文章频道</a>
        <a href="/search">全站搜索</a>
      </div>
    </div>

    {% if not is_logged_in %}
      <div class="xedc-sidebar__widget xedc-sidebar__login">
        <h3 class="xedc-sidebar__title">加入我们</h3>
        <p class="xedc-text-sm xedc-text-muted">登录后查看个性化推荐。</p>
        <div class="xedc-flex xedc-gap-2" style="margin-top: var(--space-3);">
          <a href="/user/login" class="xedc-btn xedc-btn--default xedc-btn--sm">登录</a>
          <a href="/user/register" class="xedc-btn xedc-btn--outline xedc-btn--sm">注册</a>
        </div>
      </div>
    {% endif %}
  </aside>
</div>

<footer class="xedc-footer" role="contentinfo">
  <div class="xedc-container">
    <nav class="xedc-footer__nav" aria-label="底部导航">
      {{ drupal_menu('footer') }}
    </nav>
    <div class="xedc-footer__bottom">
      <p class="xedc-text-xs xedc-text-muted">© {{ "now"|date("Y") }} {{ site_name }}. All rights reserved.</p>
    </div>
  </div>
</footer>

{{ page_bottom }}
{{ scripts }}
</body>
</html>
