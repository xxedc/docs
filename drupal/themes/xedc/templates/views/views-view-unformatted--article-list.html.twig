{% if rows %}
  <div class="xedc-feed__featured">
    {{ rows[0].content }}
  </div>
  {% if rows|length > 1 %}
    <div class="xedc-feed__grid">
      {% for row in rows|slice(1) %}
        <div class="xedc-feed__item">
          {{ row.content }}
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endif %}
