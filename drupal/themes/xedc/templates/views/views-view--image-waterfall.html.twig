{#
  views-view--image-waterfall.html.twig — 图片瀑布流页（外层包装）
  工具栏、分页、列数控制都在这里；样式模板只负责渲染卡片网格。
#}
{{ attach_library('xedc/page-image-list') }}
{% set _category = active_category|default('all') %}
{% set _sort = active_sort|default('new') %}
{% set _tag = active_tag|default('') %}
{% set _today = active_today|default(false) %}
{% set _categories = categories|default([]) %}
{% set _tabs = tag_tabs|default([]) %}
{% set _stats = stats|default({}) %}
{% set _today_items = today_updates|default([]) %}

<div class="xedc-image-waterfall" data-page="image-list">
  <div class="xedc-image-page">

    <aside class="xedc-image-sidebar" id="image-sidebar" aria-label="侧边栏">
      <div class="xedc-image-sidebar__inner">
        <div class="xedc-image-sidebar__section">
          <a class="xedc-side-item{% if _sort == 'new' and not _today and _tag == '' %} is-active{% endif %}" href="{{ nav_home_url|default('/images') }}">
            <span class="xedc-side-item__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </span>
            <span class="xedc-side-item__text">首页</span>
          </a>
          <a class="xedc-side-item{% if _sort == 'new' and not _today %} is-active{% endif %}" href="{{ nav_new_url|default('/images') }}">
            <span class="xedc-side-item__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            </span>
            <span class="xedc-side-item__text">最新发布</span>
          </a>
          <a class="xedc-side-item{% if _sort == 'hot' %} is-active{% endif %}" href="{{ nav_hot_url|default('/images?sort=hot') }}">
            <span class="xedc-side-item__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l1.5 6H20l-5 4 2 7-5-4-5 4 2-7-5-4h6.5z"/></svg>
            </span>
            <span class="xedc-side-item__text">最多浏览</span>
          </a>
          <a class="xedc-side-item{% if _today %} is-active{% endif %}" href="{{ nav_today_url|default('/images?today=1') }}">
            <span class="xedc-side-item__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l3 2"/></svg>
            </span>
            <span class="xedc-side-item__text">今日更新</span>
          </a>
        </div>

        <div class="xedc-image-sidebar__divider"></div>

        <div class="xedc-image-sidebar__section">
          <div class="xedc-side-section-title">分类</div>
          {% for c in _categories %}
            {% if c.key|default('') != 'all' %}
              <a class="xedc-side-item xedc-side-item--sub{% if (c.key|default('') == _category) %} is-active{% endif %}" href="{{ c.url }}">
                <span class="xedc-side-item__icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 8V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v1"/><path d="M3 8v11a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
                </span>
                <span class="xedc-side-item__text">{{ c.label }}</span>
              </a>
            {% endif %}
          {% endfor %}
          {% if _categories|length <= 1 %}
            <div class="xedc-side-empty">暂无分类</div>
          {% endif %}
        </div>

        <div class="xedc-image-sidebar__divider"></div>

        <div class="xedc-image-sidebar__section">
          <div class="xedc-side-section-title">我的</div>
          {% if is_logged_in %}
            <a class="xedc-side-item" href="/user/{{ current_user.id() }}?tab=collects">
              <span class="xedc-side-item__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
              </span>
              <span class="xedc-side-item__text">我的收藏</span>
            </a>
            <a class="xedc-side-item" href="/user/{{ current_user.id() }}?tab=history">
              <span class="xedc-side-item__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l3 2"/></svg>
              </span>
              <span class="xedc-side-item__text">浏览历史</span>
            </a>
            <a class="xedc-side-item" href="/user/{{ current_user.id() }}?tab=posts">
              <span class="xedc-side-item__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              </span>
              <span class="xedc-side-item__text">我的发布</span>
            </a>
          {% else %}
            <a class="xedc-side-item" href="/user/login?destination=/images">
              <span class="xedc-side-item__icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/><path d="M21 19V5a2 2 0 0 0-2-2h-7"/></svg>
              </span>
              <span class="xedc-side-item__text">登录查看更多</span>
            </a>
          {% endif %}
        </div>

        <div class="xedc-image-sidebar__spacer"></div>

        <a class="xedc-creator-card" href="/publish">
          <div class="xedc-creator-card__title">成为创作者</div>
          <div class="xedc-creator-card__sub">发布作品，获得曝光与关注</div>
          <div class="xedc-creator-card__cta">
            <span>立即上传</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          </div>
        </a>
      </div>
    </aside>

    <div class="xedc-image-main">

      <section class="xedc-stats" aria-label="统计概览">
        <div class="xedc-stats__track">
          <div class="xedc-stat-card">
            <div class="xedc-stat-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M3 15l4-4 4 4 4-4 6 6"/></svg>
            </div>
            <div class="xedc-stat-card__body">
              <div class="xedc-stat-card__label">图片总数</div>
              <div class="xedc-stat-card__value">{{ (_stats.total_images|default(0))|number_format }}+</div>
            </div>
          </div>
          <div class="xedc-stat-card">
            <div class="xedc-stat-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l3 2"/></svg>
            </div>
            <div class="xedc-stat-card__body">
              <div class="xedc-stat-card__label">今日更新</div>
              <div class="xedc-stat-card__value">{{ (_stats.today_images|default(0))|number_format }}+</div>
            </div>
          </div>
          <div class="xedc-stat-card">
            <div class="xedc-stat-card__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h6v6H4z"/><path d="M14 4h6v6h-6z"/><path d="M4 14h6v6H4z"/><path d="M14 14h6v6h-6z"/></svg>
            </div>
            <div class="xedc-stat-card__body">
              <div class="xedc-stat-card__label">分类数量</div>
              <div class="xedc-stat-card__value">{{ _stats.category_count|default(0) }}</div>
            </div>
          </div>
        </div>
      </section>

      <section class="xedc-today" aria-label="今日更新">
        <div class="xedc-section-head">
          <h2 class="xedc-section-head__title">今日更新</h2>
          <a class="xedc-section-head__more" href="{{ nav_today_url|default('/images?today=1') }}">查看更多</a>
        </div>
        <div class="xedc-today__scroller">
          {% for item in _today_items %}
            <a class="xedc-today-card" href="{{ item.url }}">
              <div class="xedc-today-card__thumb">
                {% if item.cover %}
                  <img src="{{ item.cover }}" alt="{{ item.title }}" loading="lazy" />
                {% else %}
                  <div class="xedc-today-card__placeholder"></div>
                {% endif %}
                <span class="xedc-today-card__badge">NEW</span>
              </div>
              <div class="xedc-today-card__meta">
                <div class="xedc-today-card__title">{{ item.title }}</div>
                <time class="xedc-today-card__time" datetime="{{ item.created|date('c') }}">{{ item.created|relative_time }}</time>
              </div>
            </a>
          {% endfor %}
        </div>
      </section>

      <section class="xedc-filter" aria-label="筛选">
        <div class="xedc-filter__row">
          <nav class="xedc-pills" role="tablist" aria-label="图片筛选">
            {% for t in _tabs %}
              {% set _is_active = false %}
              {% if t.key == 'recommend' %}
                {% set _is_active = (_sort == 'new' and _tag == '') %}
              {% elseif t.key == 'new' %}
                {% set _is_active = (_sort == 'new') %}
              {% elseif t.key == 'hot' %}
                {% set _is_active = (_sort == 'hot') %}
              {% else %}
                {% set _is_active = (_tag != '' and (t.key|default('') == _tag)) %}
              {% endif %}
              <a href="{{ t.url }}" class="xedc-pill{% if _is_active %} is-active{% endif %}" role="tab">{{ t.label }}</a>
            {% endfor %}
          </nav>
          <div class="xedc-filter__actions">
            <a class="xedc-filter-icon-btn{% if _category != 'all' or _today %} is-active{% endif %}" href="#image-sidebar" aria-label="筛选">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/>
              </svg>
              筛选
            </a>
          </div>
        </div>
        <nav class="xedc-category-pills" aria-label="分类筛选">
          {% for c in _categories %}
            {% set _is_active_cat = (c.key|default('') == _category) %}
            <a class="xedc-category-pill{% if _is_active_cat %} is-active{% endif %}" href="{{ c.url }}">{{ c.label }}</a>
          {% endfor %}
        </nav>
      </section>

      {% if active_search is defined and active_search %}
        <div class="xedc-image-waterfall__search-hint">
          搜索：{{ active_search }}
        </div>
      {% endif %}

      {% if rows %}
        {{ rows }}
      {% else %}
        <div class="xedc-empty-state">
          <div class="xedc-empty-state__icon">🖼️</div>
          <h3 class="xedc-empty-state__title">暂无图片</h3>
          <p class="xedc-text-sm xedc-text-muted">还没有图片内容</p>
        </div>
      {% endif %}

      <div class="xedc-image-waterfall__bottom">
        {% if pager %}
          <div class="xedc-pager">{{ pager }}</div>
        {% endif %}
      </div>

      <button class="xedc-back-to-top" id="xedc-back-to-top" aria-label="回到顶部">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="18 15 12 9 6 15"/>
        </svg>
      </button>
    </div>
  </div>

  <nav class="xedc-bottom-nav" aria-label="底部导航">
    <a class="xedc-bottom-nav__item" href="{{ url('<front>') }}">
      <span class="xedc-bottom-nav__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
      </span>
      <span class="xedc-bottom-nav__text">首页</span>
    </a>
    <a class="xedc-bottom-nav__item" href="/images">
      <span class="xedc-bottom-nav__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M3 15l4-4 4 4 4-4 6 6"/></svg>
      </span>
      <span class="xedc-bottom-nav__text">分类</span>
    </a>
    <a class="xedc-bottom-nav__publish" href="/publish" aria-label="发布">
      <span class="xedc-bottom-nav__publish-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
      </span>
    </a>
    <a class="xedc-bottom-nav__item" href="/messages">
      <span class="xedc-bottom-nav__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a4 4 0 0 1-4 4H7l-4 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
      </span>
      <span class="xedc-bottom-nav__text">消息</span>
    </a>
    {% if is_logged_in %}
      <a class="xedc-bottom-nav__item" href="/user/{{ current_user.id() }}">
        <span class="xedc-bottom-nav__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </span>
        <span class="xedc-bottom-nav__text">我的</span>
      </a>
    {% else %}
      <a class="xedc-bottom-nav__item" href="/user/login?destination=/images">
        <span class="xedc-bottom-nav__icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/><path d="M21 19V5a2 2 0 0 0-2-2h-7"/></svg>
        </span>
        <span class="xedc-bottom-nav__text">我的</span>
      </a>
    {% endif %}
  </nav>
</div>
