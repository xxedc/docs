{#
  views-view--image-waterfall.html.twig — 图片瀑布流页（外层包装）
  全站统一布局：左侧导航由 page.html.twig 的 .xedc-gsidebar 提供，
  本模板只负责主内容区（统计卡 / 今日更新 / 筛选 / 瀑布流）。
#}
{{ attach_library('xedc/page-image-list') }}
{% set _category = active_category|default('all') %}
{% set _sort = active_sort|default('new') %}
{% set _tag = active_tag|default('') %}
{% set _today = active_today|default(false) %}
{% set _categories = categories|default([]) %}
{% set _tabs = tag_tabs|default([]) %}
{% set _stats = stats|default({}) %}
{% set _today_items = today_updates|default([]) %}

<div class="xedc-image-waterfall" data-page="image-list">
  <div class="xedc-image-main">

    <section class="xedc-stats" aria-label="统计概览">
      <div class="xedc-stats__track">
        <div class="xedc-stat-card">
          <div class="xedc-stat-card__icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M3 15l4-4 4 4 4-4 6 6"/></svg>
          </div>
          <div class="xedc-stat-card__body">
            <div class="xedc-stat-card__label">图片总数</div>
            <div class="xedc-stat-card__value">{{ (_stats.total_images|default(0))|number_format }}+</div>
          </div>
        </div>
        <div class="xedc-stat-card">
          <div class="xedc-stat-card__icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l3 2"/></svg>
          </div>
          <div class="xedc-stat-card__body">
            <div class="xedc-stat-card__label">今日更新</div>
            <div class="xedc-stat-card__value">{{ (_stats.today_images|default(0))|number_format }}+</div>
          </div>
        </div>
        <div class="xedc-stat-card">
          <div class="xedc-stat-card__icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h6v6H4z"/><path d="M14 4h6v6h-6z"/><path d="M4 14h6v6H4z"/><path d="M14 14h6v6h-6z"/></svg>
          </div>
          <div class="xedc-stat-card__body">
            <div class="xedc-stat-card__label">分类数量</div>
            <div class="xedc-stat-card__value">{{ _stats.category_count|default(0) }}</div>
          </div>
        </div>
      </div>
    </section>

    {% if _today_items %}
    <section class="xedc-today" aria-label="今日更新">
      <div class="xedc-section-head">
        <h2 class="xedc-section-head__title">今日更新</h2>
        <a class="xedc-section-head__more" href="{{ nav_today_url|default('/images?today=1') }}">查看更多</a>
      </div>
      <div class="xedc-today__scroller">
        {% for item in _today_items %}
          <a class="xedc-today-card" href="{{ item.url }}">
            <div class="xedc-today-card__thumb">
              {% if item.cover %}
                <img src="{{ item.cover }}" alt="{{ item.title }}" loading="lazy" />
              {% else %}
                <div class="xedc-today-card__placeholder"></div>
              {% endif %}
              <span class="xedc-today-card__badge">NEW</span>
            </div>
            <div class="xedc-today-card__meta">
              <div class="xedc-today-card__title">{{ item.title }}</div>
              <time class="xedc-today-card__time" datetime="{{ item.created|date('c') }}">{{ item.created|relative_time }}</time>
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <section class="xedc-filter" aria-label="筛选">
      <div class="xedc-filter__row">
        <nav class="xedc-pills" role="tablist" aria-label="图片筛选">
          {% for t in _tabs %}
            {% set _is_active = false %}
            {% if t.key == 'recommend' %}
              {% set _is_active = (_sort == 'new' and _tag == '') %}
            {% elseif t.key == 'new' %}
              {% set _is_active = (_sort == 'new') %}
            {% elseif t.key == 'hot' %}
              {% set _is_active = (_sort == 'hot') %}
            {% else %}
              {% set _is_active = (_tag != '' and (t.key|default('') == _tag)) %}
            {% endif %}
            <a href="{{ t.url }}" class="xedc-pill{% if _is_active %} is-active{% endif %}" role="tab">{{ t.label }}</a>
          {% endfor %}
        </nav>
      </div>
      {% if _categories %}
      <nav class="xedc-category-pills" aria-label="分类筛选">
        {% for c in _categories %}
          {% set _is_active_cat = (c.key|default('') == _category) %}
          <a class="xedc-category-pill{% if _is_active_cat %} is-active{% endif %}" href="{{ c.url }}">{{ c.label }}</a>
        {% endfor %}
      </nav>
      {% endif %}
    </section>

    {% if active_search is defined and active_search %}
      <div class="xedc-image-waterfall__search-hint">
        搜索：{{ active_search }}
      </div>
    {% endif %}

    {% if rows %}
      {{ rows }}
    {% else %}
      <div class="xedc-empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.4" style="margin:0 auto var(--space-3)"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15 16 10 5 21"/></svg>
        <h3 class="xedc-empty-state__title">暂无图片</h3>
        <p class="xedc-text-sm xedc-text-muted">还没有图片内容</p>
      </div>
    {% endif %}

    <div class="xedc-image-waterfall__bottom">
      {% if pager %}
        <div class="xedc-pager">{{ pager }}</div>
      {% endif %}
    </div>

    <button class="xedc-back-to-top" id="xedc-back-to-top" aria-label="回到顶部">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="18 15 12 9 6 15"/>
      </svg>
    </button>
  </div>
</div>
