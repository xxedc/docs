{#
  views-view--video-list.html.twig — 视频列表页（现代简约风格）
#}
{{ attach_library('xedc/page-video-list') }}
<div class="xedc-video-list">

  {% if exposed %}
    <div class="xedc-list-toolbar">
      {{ exposed }}
    </div>
  {% endif %}

  {% if rows %}
    <div class="xedc-video-grid" data-view-container="video-list">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="xedc-empty-state">
      <div class="xedc-empty-state__icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.25">
          <rect x="2" y="2" width="20" height="20" rx="4"/>
          <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/>
        </svg>
      </div>
      <h3 class="xedc-empty-state__title">暂无视频</h3>
      <p class="xedc-empty-state__desc">还没有视频内容</p>
      {% if is_logged_in %}
        <a href="/publish" class="xedc-btn--primary">上传视频</a>
      {% endif %}
    </div>
  {% endif %}

  {% if pager %}
    <div class="xedc-pager">{{ pager }}</div>
  {% endif %}

</div>
