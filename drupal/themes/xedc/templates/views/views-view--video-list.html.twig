{#
  views-view--video-list.html.twig — 视频列表页视图模板
#}
{{ attach_library('xedc/page-video-list') }}
<div class="xedc-video-list">

  {# 筛选排序栏 #}
  <div class="xedc-list-toolbar xedc-flex xedc-flex-between">
    <div class="xedc-list-toolbar__filters">
      {% if exposed %}
        <div class="xedc-exposed-filters">{{ exposed }}</div>
      {% endif %}
    </div>
    {# 视图模式切换 #}
    <div class="xedc-view-mode-switch" data-xedc-view-mode="video-list">
      <button class="xedc-view-mode-btn is-active" data-mode="grid" aria-label="网格视图" title="网格">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
          <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
        </svg>
      </button>
      <button class="xedc-view-mode-btn" data-mode="list" aria-label="列表视图" title="列表">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
          <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
          <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  {# 内容区 #}
  {% if rows %}
    <div class="xedc-video-grid" data-view-container="video-list">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="xedc-empty-state">
      <div class="xedc-empty-state__icon">🎬</div>
      <h3 class="xedc-empty-state__title">暂无视频</h3>
      <p class="xedc-empty-state__desc xedc-text-muted">还没有视频内容，快来上传第一个吧</p>
      {% if is_logged_in %}
        <a href="/publish" class="xedc-btn xedc-btn--default xedc-btn--md" style="margin-top: var(--space-4);">上传视频</a>
      {% endif %}
    </div>
  {% endif %}

  {# 分页 #}
  {% if pager %}
    <div class="xedc-pager">{{ pager }}</div>
  {% endif %}

  {# 回到顶部 #}
  <button class="xedc-back-to-top" id="xedc-back-to-top" aria-label="回到顶部" title="回到顶部">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="18 15 12 9 6 15"/>
    </svg>
  </button>

</div>

{# 移动端底部导航 #}
<nav class="xedc-bottom-nav" aria-label="底部导航">
  <a class="xedc-bottom-nav__item" href="{{ url('<front>') }}">
    <span class="xedc-bottom-nav__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
    </span>
    <span class="xedc-bottom-nav__text">首页</span>
  </a>
  <a class="xedc-bottom-nav__item is-active" href="/videos">
    <span class="xedc-bottom-nav__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m16 13 5.223 3.482A1 1 0 0 0 23 15.65V8.35a1 1 0 0 0-1.777-.832L16 11V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-3z"/></svg>
    </span>
    <span class="xedc-bottom-nav__text">视频</span>
  </a>
  <a class="xedc-bottom-nav__publish" href="/publish" aria-label="发布">
    <span class="xedc-bottom-nav__publish-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
    </span>
  </a>
  <a class="xedc-bottom-nav__item" href="/messages">
    <span class="xedc-bottom-nav__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a4 4 0 0 1-4 4H7l-4 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
    </span>
    <span class="xedc-bottom-nav__text">消息</span>
  </a>
  <a class="xedc-bottom-nav__item" href="/user">
    <span class="xedc-bottom-nav__icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </span>
    <span class="xedc-bottom-nav__text">我的</span>
  </a>
</nav>
