{#
  views-view-grid--article-list.html.twig
  覆盖 grid_responsive 格式，将文章列表强制输出为单列
#}
{% for row in rows %}
  {% for column in row.columns %}
    {% if column.content %}
      {% for content in column.content %}
        {{ content.content }}
      {% endfor %}
    {% endif %}
  {% endfor %}
{% endfor %}
