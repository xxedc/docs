<?php

/**
 * @file
 * xedc_core.module — XEDC 核心功能模块
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * 实现 hook_node_view() — 记录浏览历史 + 附加互动库
 */
function xedc_core_node_view(array &$build, EntityInterface $entity, $display, $view_mode): void {
  if (!$entity instanceof NodeInterface) {
    return;
  }

  // 只在完整详情页记录
  if ($view_mode !== 'full') {
    return;
  }

  $nid = $entity->id();
  $current_user = \Drupal::currentUser();

  // 记录浏览历史（已登录用户）
  if ($current_user->isAuthenticated()) {
    /** @var \Drupal\xedc_core\Service\HistoryService $history */
    $history = \Drupal::service('xedc_core.history');
    $history->record($nid, $entity->bundle());
  }

  // 附加互动 JS 库
  $build['#attached']['library'][] = 'xedc_core/interactions';

  // 传递 nid 和 CSRF token 给 JS
  $token = \Drupal::csrfToken()->get('xedc-api');
  $build['#attached']['drupalSettings']['xedc']['nid'] = $nid;
  $build['#attached']['drupalSettings']['xedc']['csrfToken'] = $token;
  $build['#attached']['drupalSettings']['xedc']['isLoggedIn'] = $current_user->isAuthenticated();
  $build['#attached']['drupalSettings']['xedc']['uid'] = $current_user->id();
}

/**
 * 实现 hook_page_attachments() — 全局注入设置
 */
function xedc_core_page_attachments(array &$attachments): void {
  $current_user = \Drupal::currentUser();
  $token = \Drupal::csrfToken()->get('xedc-api');

  $attachments['#attached']['drupalSettings']['xedc']['csrfToken'] = $token;
  $attachments['#attached']['drupalSettings']['xedc']['isLoggedIn'] = $current_user->isAuthenticated();
  $attachments['#attached']['drupalSettings']['xedc']['uid'] = (int) $current_user->id();
  $attachments['#attached']['drupalSettings']['xedc']['apiBase'] = '/api';
}

/**
 * 实现 hook_schema() — 创建自定义数据表
 */
function xedc_core_schema(): array {
  $schema = [];

  // 浏览历史表
  $schema['xedc_history'] = [
    'description' => '用户浏览历史记录',
    'fields' => [
      'id'         => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid'        => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'nid'        => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'bundle'     => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE, 'default' => ''],
      'timestamp'  => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid_timestamp' => ['uid', 'timestamp'],
      'nid'           => ['nid'],
    ],
  ];

  // 点赞表
  $schema['xedc_likes'] = [
    'description' => '内容点赞记录',
    'fields' => [
      'id'        => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid'       => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'nid'       => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'timestamp' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['uid_nid' => ['uid', 'nid']],
    'indexes'     => ['nid' => ['nid']],
  ];

  // 收藏表
  $schema['xedc_collects'] = [
    'description' => '内容收藏记录',
    'fields' => [
      'id'        => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid'       => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'nid'       => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'timestamp' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['uid_nid' => ['uid', 'nid']],
    'indexes'     => ['nid' => ['nid']],
  ];

  // 关注表
  $schema['xedc_follows'] = [
    'description' => '用户关注关系',
    'fields' => [
      'id'          => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'follower_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'followee_id' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'timestamp'   => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['follower_followee' => ['follower_id', 'followee_id']],
  ];

  // 通知表
  $schema['xedc_notifications'] = [
    'description' => '用户通知消息',
    'fields' => [
      'id'          => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid'         => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'type'        => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'message'     => ['type' => 'text', 'not null' => TRUE],
      'entity_id'   => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE, 'default' => NULL],
      'actor_id'    => ['type' => 'int', 'unsigned' => TRUE, 'not null' => FALSE, 'default' => NULL],
      'is_read'     => ['type' => 'int', 'size' => 'tiny', 'not null' => TRUE, 'default' => 0],
      'timestamp'   => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid_read'  => ['uid', 'is_read'],
      'timestamp' => ['timestamp'],
    ],
  ];

  return $schema;
}

/**
 * 实现 hook_install() — 初始化
 */
function xedc_core_install(): void {
  \Drupal::messenger()->addStatus('XEDC Core 模块安装成功！');
}


/**
 * 实现 hook_theme() — 注册自定义 Twig 模板
 */
function xedc_core_theme(): array {
  return [
    'xedc_hot_rank' => [
      'variables' => ['items' => []],
      'template'  => 'xedc-hot-rank',
    ],
    'xedc_category_nav' => [
      'variables' => ['items' => []],
      'template'  => 'xedc-category-nav',
    ],
    'xedc_article_actions' => [
      'variables' => ['node' => NULL, 'nid' => 0, 'like_count' => 0, 'is_logged_in' => FALSE],
      'template'  => 'xedc-article-actions',
    ],
    'xedc_related_content' => [
      'variables' => ['items' => []],
      'template'  => 'xedc-related-content',
    ],
    'xedc_recommend_users' => [
      'variables' => ['items' => []],
      'template'  => 'xedc-recommend-users',
    ],
  ];
}

/**
 * Implements hook_views_pre_view().
 *
 * Disable the Views results cache for image_waterfall / article_list BEFORE
 * the cache plugin is instantiated. Custom filtering via query params
 * (category/tag/sort/search/today) is invisible to Views' default cache key,
 * so cached results would ignore filters.
 */
function xedc_core_views_pre_view(\Drupal\views\ViewExecutable $view, $display_id, array &$args): void {
  if (!in_array($view->id(), ['image_waterfall', 'article_list'], TRUE)) {
    return;
  }
  try {
    if ($view->display_handler) {
      $view->display_handler->setOption('cache', ['type' => 'none']);
    }
  } catch (\Throwable $e) {}
}

/**
 * Implements hook_views_pre_execute().
 *
 * Belt-and-suspenders: just before the cache check in execute(), force the
 * cache plugin to 'none' via reflection (in case pre_view didn't catch it).
 */
function xedc_core_views_pre_execute(\Drupal\views\ViewExecutable $view): void {
  if (!in_array($view->id(), ['image_waterfall', 'article_list'], TRUE)) {
    return;
  }
  try {
    $view->display_handler->setOption('cache', ['type' => 'none']);

    $reflection = new \ReflectionObject($view->display_handler);
    if ($reflection->hasProperty('plugins')) {
      $plugins_prop = $reflection->getProperty('plugins');
      $plugins_prop->setAccessible(TRUE);
      $plugins = $plugins_prop->getValue($view->display_handler);

      if (!empty($plugins['cache']) && is_object($plugins['cache'])) {
        try { $plugins['cache']->cacheFlush(); } catch (\Throwable $e2) {}
      }

      $none = \Drupal\views\Views::pluginManager('cache')->createInstance('none');
      if ($none) {
        $none->init($view, $view->display_handler);
        $plugins['cache'] = $none;
        $plugins_prop->setValue($view->display_handler, $plugins);
      }
    }
  } catch (\Throwable $e) {}
}

/**
 * Implements hook_views_query_alter().
 *
 * Apply category / tag / sort / search / today filters from URL query args.
 * Module-level implementation: themes can also implement this hook, but
 * the module path is the most reliable (guaranteed discovery).
 */
function xedc_core_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  if (!in_array($view->id(), ['image_waterfall', 'article_list'], TRUE)) {
    return;
  }
  if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
    return;
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  if (!$request) {
    return;
  }

  if ($view->id() === 'article_list') {
    $category = $request->query->get('category');
    if ($category && $category !== 'all' && ctype_digit((string) $category)) {
      $category_table = $query->ensureTable('node__field_category', $view->relationship);
      if ($category_table) {
        $query->addWhere(0, $category_table . '.field_category_target_id', (int) $category, '=');
      }
    }

    $sort = (string) ($request->query->get('sort') ?? '');
    if ($sort !== 'new') {
      $view_count_table = $query->ensureTable('node__field_view_count', $view->relationship);
      if ($view_count_table) {
        $query->addOrderBy($view_count_table, 'field_view_count_value', 'DESC');
      }
    }
    return;
  }

  // image_waterfall
  $category = $request->query->get('category');
  if ($category && $category !== 'all' && ctype_digit((string) $category)) {
    $category_table = $query->ensureTable('node__field_category', $view->relationship);
    if ($category_table) {
      $query->addWhere(0, $category_table . '.field_category_target_id', (int) $category, '=');
    }
  }

  $search = (string) ($request->query->get('search') ?? $request->query->get('q') ?? '');
  $search = trim($search);
  if ($search !== '') {
    $base_table = $query->ensureTable('node_field_data', $view->relationship);
    if ($base_table) {
      $escaped = \Drupal::database()->escapeLike($search);
      $query->addWhere(0, $base_table . '.title', '%' . $escaped . '%', 'LIKE');
    }
  }

  $tag = (string) ($request->query->get('tag') ?? '');
  if ($tag !== '' && ctype_digit($tag)) {
    $tag_table = $query->ensureTable('node__field_tags', $view->relationship);
    if ($tag_table) {
      $query->addWhere(0, $tag_table . '.field_tags_target_id', (int) $tag, '=');
    }
  }

  $today = (string) ($request->query->get('today') ?? '');
  if ($today === '1' || $today === 'true') {
    $start_today = (new \DateTimeImmutable('today', new \DateTimeZone(date_default_timezone_get())))->getTimestamp();
    $base_table_today = $query->ensureTable('node_field_data', $view->relationship);
    if ($base_table_today) {
      $query->addWhere(0, $base_table_today . '.created', $start_today, '>=');
    }
  }

  $sort = (string) ($request->query->get('sort') ?? 'new');
  if (!in_array($sort, ['new', 'hot', 'random'], TRUE)) {
    $sort = 'new';
  }

  try { $query->orderby = []; } catch (\Throwable $e) {}

  $base_table = $query->ensureTable('node_field_data', $view->relationship);

  if ($sort === 'random') {
    $query->addOrderBy(NULL, 'RAND()', 'ASC');
    return;
  }

  if ($sort === 'hot') {
    $view_count_table = $query->ensureTable('node__field_view_count', $view->relationship);
    if ($view_count_table) {
      $query->addOrderBy($view_count_table, 'field_view_count_value', 'DESC');
    }
  }

  if ($base_table) {
    $query->addOrderBy($base_table, 'created', 'DESC');
  }
}

