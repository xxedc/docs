{#
  node--video--teaser.html.twig — 视频卡片（列表用）
#}
{% set video_url = url %}
{% set nid = node.id() %}
{% set owner_name = owner_name|default(node.getOwner().getDisplayName()) %}
{% set owner_profile_url = owner_profile_url|default('/user/' ~ node.getOwnerId()) %}
{% set owner_avatar_url = owner_avatar_url|default('') %}
{% set owner_avatar_initial = owner_avatar_initial|default(owner_name|slice(0, 1)|upper) %}
{% set orientation = node.field_orientation.value %}

<article{{ attributes.addClass('xedc-video-card', orientation == 'portrait' ? 'xedc-video-card--portrait' : '') }} data-nid="{{ nid }}">
  <div class="xedc-video-card__cover">
    <a href="{{ video_url }}" class="xedc-video-card__cover-link" tabindex="-1" aria-hidden="true">
      {% if cover_image_url %}
        <img src="{{ cover_image_url }}" alt="{{ label }}" loading="lazy" />
      {% else %}
        <div class="xedc-video-card__cover-placeholder">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
        </div>
      {% endif %}
    </a>

    {% if node.field_duration.value %}
      {% set duration = node.field_duration.value %}
      {% set minutes = (duration / 60)|round(0, 'floor') %}
      {% set seconds = duration % 60 %}
      <span class="xedc-video-card__duration">{{ minutes }}:{{ seconds < 10 ? '0' ~ seconds : seconds }}</span>
    {% endif %}

    {% set quality_val = node.field_quality.value %}
    {% if quality_val %}
      <span class="xedc-badge xedc-video-card__quality {{ quality_val == '720p' ? 'xedc-badge--success' : 'xedc-badge--default' }}">
        {%- if quality_val == '4k' -%}4K
        {%- elseif quality_val == '1080p' -%}1080P
        {%- elseif quality_val == '720p' -%}720P
        {%- elseif quality_val == '480p' -%}480P
        {%- else -%}{{ quality_val|split('|')|last|upper }}
        {%- endif -%}
      </span>
    {% endif %}

    <div class="xedc-video-card__play-overlay" aria-hidden="true">
      <svg width="52" height="52" viewBox="0 0 52 52">
        <circle cx="26" cy="26" r="26" fill="rgba(0,0,0,0.55)"/>
        <polygon points="21 17 38 26 21 35 21 17" fill="white"/>
      </svg>
    </div>
  </div>

  <div class="xedc-video-card__info">
    <h3 class="xedc-video-card__title">
      <a href="{{ video_url }}">{{ label }}</a>
    </h3>

    <div class="xedc-video-card__author">
      {% if owner_avatar_url %}
        <a href="{{ owner_profile_url }}" class="xedc-avatar xedc-avatar--xs xedc-avatar--img" aria-label="{{ owner_name }}">
          <img src="{{ owner_avatar_url }}" alt="{{ owner_name }}" />
        </a>
      {% else %}
        <a href="{{ owner_profile_url }}" class="xedc-avatar xedc-avatar--xs" aria-label="{{ owner_name }}"
           style="background:oklch(0.62 0.16 {{ [220,280,155,30,340,190,320,55][owner_name|length % 8] }});">
          {{ owner_avatar_initial }}
        </a>
      {% endif %}
      <a href="{{ owner_profile_url }}" class="xedc-video-card__author-name">{{ owner_name }}</a>
    </div>

    <div class="xedc-video-card__meta">
      <span class="xedc-text-xs xedc-text-muted">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="display:inline;vertical-align:middle;">
          <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"/>
        </svg>
        {{ view_count|default(0) }}
      </span>
      <span class="xedc-text-xs xedc-text-muted">{{ node.getCreatedTime()|date('Y-m-d') }}</span>
    </div>

    <div class="xedc-video-card__actions">
      {% if is_logged_in %}
        <button class="xedc-icon-btn xedc-like-btn" data-nid="{{ nid }}" aria-label="点赞">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</article>
